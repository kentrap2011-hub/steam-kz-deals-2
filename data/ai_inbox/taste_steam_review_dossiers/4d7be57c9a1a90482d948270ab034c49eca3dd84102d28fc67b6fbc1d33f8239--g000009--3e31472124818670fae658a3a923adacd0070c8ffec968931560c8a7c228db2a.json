        },
        {
          "category": "repetition",
          "statement": "The mostly linear sequence, simple mechanics and single emotional arc offer little varied content for further replays, even if the score or finale encourages reliving it.",
          "sentiment": "mixed",
          "recurrence": "limited",
          "mention_count": 3,
