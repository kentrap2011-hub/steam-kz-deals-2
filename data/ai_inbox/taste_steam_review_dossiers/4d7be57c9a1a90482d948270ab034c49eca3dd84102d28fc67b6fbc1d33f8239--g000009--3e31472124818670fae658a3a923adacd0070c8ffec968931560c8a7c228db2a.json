          ]
        },
        {
          "category": "friction",
          "statement": "Checkpoint-only saves, dim navigation in places and occasionally confusing controls or interactions can frustrate those looking primarily for mechanically polished puzzles.",
          "sentiment": "negative",
          "recurrence": "limited",
          "mention_count": 2,
