          ]
        },
        {
          "category": "pacing",
          "statement": "A normal first completion is commonly described around roughly eight to eleven hours, with the sustained challenge making the compact campaign feel substantial rather than brief.",
          "sentiment": "neutral",
          "recurrence": "limited",
          "mention_count": 2,
