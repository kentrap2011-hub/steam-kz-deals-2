          ]
        },
        {
          "category": "progression",
          "statement": "Later movement tools and level gimmicks broaden traversal beyond the initial climbing picks, but some players dislike the shift toward wall jumps, dashes, grappling and more prescribed platforming.",
          "sentiment": "mixed",
          "recurrence": "limited",
          "mention_count": 2,
