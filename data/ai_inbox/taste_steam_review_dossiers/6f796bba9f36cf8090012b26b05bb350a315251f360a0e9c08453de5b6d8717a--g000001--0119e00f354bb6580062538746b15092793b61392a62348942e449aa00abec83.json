          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-003",
            "feedback-004"
          ]
        },
        {
          "category": "mechanics",
          "statement": "Vehicle handling and physics are a distinctive part of the experience: several players value the heavy body roll, momentum and reactive damage model, while others describe the handling as awkward until learned.",
          "sentiment": "mixed",
          "recurrence": "limited",
          "mention_count": 2,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
            "source-003",
            "source-004"
          ],
          "player_feedback_ids": [
            "feedback-004",
            "feedback-006"
          ]
        },
        {
          "category": "structure",
          "statement": "A recurring trade-off is mission structure: some players find the repeated drive-to-target and combat pattern overly linear or repetitive, and the open world offers fewer post-story activities than later entries.",
          "sentiment": "negative",
          "recurrence": "limited",
          "mention_count": 2,
          "evidence_languages": [
            "russian",
