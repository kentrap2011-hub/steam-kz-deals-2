      "summary": "Evidence summary: 6 validated structured observations; consult observations and conflicts for supported findings.",
      "observations": [
        {
          "category": "mechanics",
          "statement": "The central loop combines high-speed motorcycle traversal with aiming, slow-motion shooting, aerial rotation, reloading and defensive actions, making movement and combat one tightly coupled system.",
          "sentiment": "positive",
          "recurrence": "strong",
          "mention_count": 4,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
            "source-002",
            "source-003",
            "source-004"
          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-002",
            "feedback-003",
            "feedback-004"
          ]
        },
        {
          "category": "difficulty",
          "statement": "The one-hit vulnerability and need to learn terrain and enemy placement create a steep execution curve; frequent checkpoints and quick retries make mastery satisfying for some players but exhausting for others.",
          "sentiment": "mixed",
          "recurrence": "strong",
          "mention_count": 4,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
            "source-002",
