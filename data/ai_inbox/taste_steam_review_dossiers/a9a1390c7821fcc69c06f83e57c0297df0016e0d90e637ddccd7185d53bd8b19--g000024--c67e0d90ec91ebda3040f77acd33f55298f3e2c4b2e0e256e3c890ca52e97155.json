            "feedback-004"
          ]
        },
        {
          "category": "controls_game_feel",
          "statement": "Motorcycle handling is deliberately momentum-heavy and unusual: players who adapt praise the flow of flips, shots and reloads, while others experience accidental crashes or finicky traversal inputs as unfair.",
          "sentiment": "mixed",
          "recurrence": "moderate",
          "mention_count": 3,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
            "source-002",
            "source-003",
            "source-005"
          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-003",
            "feedback-005"
          ]
        },
        {
          "category": "other",
          "statement": "Art, music, atmosphere and the bleak emotional story are recurring strengths, with players frequently treating the world and presentation as reasons to continue through the difficult mechanics.",
          "sentiment": "positive",
          "recurrence": "strong",
          "mention_count": 4,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
            "source-002",
            "source-003",
            "source-004",
            "source-005"
          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-002",
            "feedback-003",
            "feedback-005"
          ]
        },
        {
          "category": "structure",
          "statement": "Exploration supports optional tasks and backtracking, but repeated travel, fetch-style side quests and a few long or awkwardly routed areas can interrupt the otherwise fast movement loop.",
          "sentiment": "mixed",
          "recurrence": "moderate",
          "mention_count": 3,
          "evidence_languages": [
            "non_russian"
          ],
          "evidence_status": "durable",
          "source_ids": [
