          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-002",
            "feedback-003"
          ]
        },
        {
          "category": "friction",
          "statement": "Combat is a recurring trade-off: slow melee timing and hit-and-retreat rhythms create tension for some players but feel repetitive or clunky to others.",
          "sentiment": "mixed",
          "recurrence": "moderate",
          "mention_count": 3,
