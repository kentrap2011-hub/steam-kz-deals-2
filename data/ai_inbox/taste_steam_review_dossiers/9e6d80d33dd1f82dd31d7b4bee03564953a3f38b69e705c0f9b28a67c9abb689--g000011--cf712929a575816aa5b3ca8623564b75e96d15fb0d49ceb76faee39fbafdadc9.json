            "source-003",
            "source-005"
          ],
          "player_feedback_ids": [
            "feedback-001",
            "feedback-002",
            "feedback-006"
          ]
        },
        {
          "category": "progression",
          "statement": "Progression expands from simple truck routes into trains, recycling and larger city supply networks; this creates a satisfying sense of scale but also increases the amount of infrastructure that must be reorganized.",
          "sentiment": "mixed",
          "recurrence": "limited",
          "mention_count": 2,
          "evidence_languages": [
            "non_russian"
          ],
          "evidence_status": "current",
          "source_ids": [
            "source-003",
            "source-005"
          ],
          "player_feedback_ids": [
            "feedback-003",
            "feedback-006"
          ]
        },
        {
          "category": "friction",
          "statement": "A recurring trade-off is logistics rigidity: depot limits, simple point-to-point transport and large rebuilds can make late-game optimization feel more tedious than strategically expressive.",
          "sentiment": "negative",
          "recurrence": "moderate",
          "mention_count": 3,
          "evidence_languages": [
            "non_russian"
          ],
          "evidence_status": "current",
          "source_ids": [
            "source-003",
            "source-005"
          ],
          "player_feedback_ids": [
            "feedback-003",
            "feedback-004",
            "feedback-006"
          ]
        },
        {
          "category": "structure",
          "statement": "Terraforming materially changes the map rather than serving only as a visual meter; rising water and climate shifts can flood infrastructure and force players to re-plan routes or protect developed areas.",
