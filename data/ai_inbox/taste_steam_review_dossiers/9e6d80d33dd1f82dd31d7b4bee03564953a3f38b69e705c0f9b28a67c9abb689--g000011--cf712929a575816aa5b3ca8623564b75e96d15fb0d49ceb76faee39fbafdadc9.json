      "summary": "Evidence summary: 4 validated structured observations; consult observations and conflicts for supported findings.",
      "observations": [
        {
          "category": "mechanics",
          "statement": "Players repeatedly describe a calm automation loop built around extracting resources, feeding growing cities and watching a barren planet visibly transform into a living world.",
          "sentiment": "positive",
          "recurrence": "moderate",
          "mention_count": 3,
          "evidence_languages": [
            "russian",
            "non_russian"
          ],
          "evidence_status": "current",
