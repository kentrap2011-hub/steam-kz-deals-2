          ]
        },
        {
          "category": "structure",
          "statement": "The narrated campaigns are a recurring presentation strength, while longer procedural chains and repeated battles are more divisive and can feel grindy once the campaign content is exhausted.",
          "sentiment": "mixed",
          "recurrence": "moderate",
          "mention_count": 3,
          "evidence_languages": [
