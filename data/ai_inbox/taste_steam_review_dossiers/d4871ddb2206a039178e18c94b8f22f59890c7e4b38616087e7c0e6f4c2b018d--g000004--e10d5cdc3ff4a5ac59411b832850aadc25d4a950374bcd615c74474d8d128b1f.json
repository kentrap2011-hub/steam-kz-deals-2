            "feedback-007"
          ]
        },
        {
          "category": "other",
          "statement": "Unusual hand-drawn transformations, unsettling audio, carefully animated grotesque set pieces and grotesque humor are common reasons players remember the experience.",
          "sentiment": "positive",
          "recurrence": "moderate",
          "mention_count": 4,
