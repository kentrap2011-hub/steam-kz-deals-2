          ]
        },
        {
          "category": "progression",
          "statement": "Late challenge modes deliberately lean harder on roguelike constraints; player discussion reports that losing permanent health or mentor advantages can make high-overtime Imposter runs feel more punishing than the main roguelite progression.",
          "sentiment": "mixed",
          "recurrence": "limited",
