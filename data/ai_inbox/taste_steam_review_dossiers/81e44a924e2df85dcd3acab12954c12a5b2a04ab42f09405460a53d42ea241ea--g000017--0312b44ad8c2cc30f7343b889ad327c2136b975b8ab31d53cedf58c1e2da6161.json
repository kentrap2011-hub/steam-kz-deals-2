            "feedback-004"
          ]
        },
        {
          "category": "repetition",
          "statement": "Run variety is a recurring trade-off: the combination system and mutations invite experimentation, but repeated events, meta builds, and limited long-term progression can make later runs feel more similar than the initial setup suggests.",
          "sentiment": "mixed",
          "recurrence": "limited",
          "mention_count": 2,
          "evidence_languages": [
