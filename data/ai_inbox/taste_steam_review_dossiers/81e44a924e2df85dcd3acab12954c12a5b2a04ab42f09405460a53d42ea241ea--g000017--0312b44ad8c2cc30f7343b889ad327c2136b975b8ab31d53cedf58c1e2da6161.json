          ],
          "player_feedback_ids": [
            "feedback-002",
            "feedback-004"
          ]
        },
        {
          "category": "difficulty",
          "statement": "Later stages can swing abruptly from manageable to punishing, with player reports describing snowball losses when key units die and bad shop or mutation rolls make rebuilding difficult.",
          "sentiment": "negative",
          "recurrence": "limited",
          "mention_count": 2,
          "evidence_languages": [
            "non_russian"
          ],
