      "observations": [
        {
          "category": "mechanics",
          "statement": "Player feedback characterizes the central loop as tactical roguelite team-building followed by automatic battles: the meaningful decisions happen in unit composition, positioning, food, weapons, mutations, purchases, and route planning before combat resolves.",
          "sentiment": "positive",
          "recurrence": "limited",
          "mention_count": 2,
