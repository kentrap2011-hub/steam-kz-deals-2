  "findings": [
    {
      "ref": "rfinding-001",
      "kind": "observation",
      "safe_neutral_synthesis": "The responsive kung-fu melee combat blends parries, structure pressure, high and low attack avoids and environmental weapons into mastery-focused encounters.",
      "polarity_hint": "positive",
      "recurrence_basis": null,
      "dimension_hints": [
