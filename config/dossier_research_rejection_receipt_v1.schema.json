{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DOSSIER-RESEARCH-REJECTION-RECEIPT-V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "owner",
    "assignment",
    "status",
    "reason_code",
    "research_package_path",
    "raw_content_sha256",
    "research_package_blob_sha",
    "research_package_git_commit",
    "validation_revision",
    "canonical_acceptance",
    "normal_first_pass_attempt_consumed",
    "retry_authorized",
    "deep_eligibility_issued"
  ],
  "properties": {
    "schema": {
      "const": "DOSSIER-RESEARCH-REJECTION-RECEIPT-V1"
    },
    "schema_version": {
      "const": 1
    },
    "owner": {
      "const": "github_control_plane"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "snapshot_id",
        "group_sequence",
        "group_sha256",
        "prepared_required_sha256",
        "group_plan_sha256",
        "items_sha256",
        "item_index",
        "appid",
        "title",
        "scope_source",
        "source_queue_sha256",
        "research_contract_sha256",
        "web_evidence_contract_binding",
        "research_marker_anchor_commit",
        "research_marker_nonce"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "group_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prepared_required_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "group_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "item_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "appid": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "scope_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "source_queue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "research_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "web_evidence_contract_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_contract_schema",
            "evidence_contract_version",
            "evidence_contract_revision",
            "evidence_contract_sha256",
            "worker_schema",
            "worker_schema_version",
            "worker_schema_revision",
            "worker_schema_sha256",
            "dossier_schema",
            "dossier_schema_version",
            "worker_prompt_revision",
            "worker_prompt_sha256"
          ],
          "properties": {
            "evidence_contract_schema": {
              "const": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2"
            },
            "evidence_contract_version": {
              "const": 2
            },
            "evidence_contract_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "evidence_contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "worker_schema": {
              "const": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V2"
            },
            "worker_schema_version": {
              "const": 2
            },
            "worker_schema_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "worker_schema_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "dossier_schema": {
              "const": "TASTE-STEAM-REVIEW-DOSSIER-V2"
            },
            "dossier_schema_version": {
              "const": 2
            },
            "worker_prompt_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "worker_prompt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "research_marker_anchor_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "research_marker_nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "status": {
      "enum": [
        "rejected_invalid",
        "research_incomplete",
        "semantic_exhausted"
      ]
    },
    "reason_code": {
      "enum": [
        "invalid_json",
        "invalid_schema",
        "invalid_binding",
        "invalid_privacy_or_provenance",
        "research_not_assembly_ready",
        "semantic_exhaustion_not_canonical"
      ]
    },
    "research_package_path": {
      "type": "string",
      "pattern": "^data/ai_inbox/dossier_research/[0-9a-f]{64}/g[0-9]{6}/[0-9]+--[a-z0-9._-]+\\.json$"
    },
    "raw_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "research_package_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "research_package_git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "validation_revision": {
      "const": "dossier-two-stage-p2-v1"
    },
    "canonical_acceptance": {
      "const": false
    },
    "normal_first_pass_attempt_consumed": {
      "const": false
    },
    "retry_authorized": {
      "const": false
    },
    "deep_eligibility_issued": {
      "const": false
    }
  }
}
