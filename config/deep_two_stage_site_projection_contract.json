        "not_ready",
        "pending",
        "completed_fit",
        "completed_not_fit",
        "diagnostic_incomplete"
      ]
    },
    "stage2_status": {
      "enum": [
        "not_eligible",
        "awaiting_calibration",
        "calibrated",
        "diagnostic_incomplete"
      ]
    },
    "stage1_provisional_deep_fit_score_0_56": {
      "type": [
        "number",
        "null"
      ],
      "visibility": "detail_only",
      "authority": "provisional_only"
    },
    "stage2_calibrated_deep_fit_score_0_56": {
      "type": [
        "number",
        "null"
      ],
      "visibility": "compact_and_detail_when_calibrated",
      "authority": "final_semantic_after_cutover"
    },
    "stage2_calibration_delta": {
      "type": [
        "number",
        "null"
      ],
      "visibility": "detail"
    },
    "wishlist_bonus_0_or_4": {
      "type": "number",
      "allowed": [
        0,
        4
      ]
    },
    "personal_quality_score_0_60": {
      "type": [
        "number",
        "null"
      ]
    },
    "purchase_score_0_40": {
      "type": "number"
    },
    "total_score_0_100": {
      "type": [
        "number",
        "null"
      ]
    },
    "priority_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stage1_point_breakdown": {
      "type": "array",
      "visibility": "detail"
    },
    "stage2_neighbor_comparisons": {
      "type": "array",
      "visibility": "detail"
    },
    "stage2_why_changed_ru": {
      "type": [
        "string",
        "null"
      ],
      "visibility": "detail"
    }
  },
  "arithmetic": {
    "personal_quality_score_0_60": "stage2_calibrated_deep_fit_score_0_56 + wishlist_bonus_0_or_4",
    "total_score_0_100": "personal_quality_score_0_60 + purchase_score_0_40",
    "stage2_calibration_delta": "stage2_calibrated_deep_fit_score_0_56 - stage1_provisional_deep_fit_score_0_56",
    "stage1_score_may_not_substitute_for_missing_stage2": true,
    "fast_score_may_not_substitute_for_missing_stage2": true
  },
  "compact_card": {
    "calibrated_rule": "show only final post-Stage-2 semantic/personal score as authoritative, plus combined offer score where the current card exposes it",
    "pending_stage2_label_ru": "Ожидает сравнительной калибровки",
    "pending_stage2_semantic_score": null,
    "fast_label_or_score_forbidden": true,
    "stage1_provisional_score_as_final_forbidden": true
  },
  "detail_view": {
    "ordered_sections": [
      "short_summary",
      "positives",
      "negatives",
      "other_nuances",
      "stage2_score_change",
      "why_above_below_neighbors"
