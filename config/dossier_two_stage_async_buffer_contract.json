{
  "schema": "DOSSIER-TWO-STAGE-ASYNC-BUFFER-CONTRACT-V2",
  "version": 2,
  "implemented": true,
  "active": false,
  "authoritative": false,
  "executable_in_production": false,
  "parent_contracts": [
    "config/dossier_two_stage_interfaces_contract.json",
    "config/dossier_two_stage_staging_contract.json"
  ],
  "owner": "github_actions_control_plane",
  "semantic_workers_implemented": false,
  "manifest_schema": "DOSSIER-TWO-STAGE-ASYNC-BUFFER-V2",
  "buffer_paths": {
    "research": "data/control/dossier_two_stage_buffers/research/{snapshot_id}/{buffer_id}.json",
    "assembly": "data/control/dossier_two_stage_buffers/assembly/{snapshot_id}/{buffer_id}.json"
  },
  "capacity": {
    "semantic_liveness_depends_on_open_slots": false,
    "previous_open_slot_cap_removed": true,
    "already_prepared_scope": "entire_exact_frozen_manifest_traversed_without_sibling_or_GitHub_acks",
    "github_may_bound_future_new_authorizations": true,
    "finite_manifest_only": true,
    "worker_may_expand_or_reissue_scope": false,
    "no_daily_quota": true,
    "github_alone_owns_retry_recovery": true,
    "canonical_writes": "none_in_this_inactive_helper"
  },
  "marker": {
    "commit": "create_only_nonce_marker_exactly_one_git_parent",
    "buffer_source": "exact_marker_parent_git_blob",
    "research_work_source": "github_prepared_assignments_in_same_marker_parent",
    "assembly_work_source": "github_prepared_preauthorization_plans_and_exact_research_prepared_work_in_same_marker_parent_no_acceptance_receipt",
    "worker_must_not_choose_prior_authority": true,
    "later_main_movement_does_not_invalidate_frozen_buffer": true
  },
  "execution": {
    "research": "iterate_full_frozen_manifest_order_no_unresolved_slot_or_previous_receipt_wait",
    "assembly": "iterate_exact_frozen_preauthorized_plans; consume_exact_submitted_Research_Git_bytes_directly; no_GitHub_Research_acceptance_wait; continue_siblings",
    "existing_transport": "already_submitted_do_not_recreate_not_accepted",
    "semantic_item_failure": "no_head_of_line_blocking_for_independent_frozen_siblings",
    "never_use_previous_sibling_receipt_for_liveness": true,
    "workers_cannot_expand_retry_reorder": true,
    "assembly_entry": "exact_prepared_plan_plus_frozen_Research_assignment_plus_immutable_submitted_Research_commit_path_blob_raw_sha256_and_canonical_sha256",
    "final_acceptance": "Github_eventually_checks_research_authorization_and_strict_receipt_then_exact_Assembly_consumed_transport_then_strict_V2_candidate_then_existing_atomic_three_game_group_ingest",
    "final_group_wait": "only_actual_strict_group_validation_not_Research_stage_or_Assembly_buffer_scheduling",
    "invalid_item": "quarantine_exact_item_chain_without_revoking_prepared_sibling_items"
  },
  "transport": {
    "research": "data/ai_inbox/dossier_research/",
    "assembly": "data/ai_inbox/dossier_assembly/",
    "create_only": true,
    "duplicate_mismatch_stale": "fail_closed_zero_mutations_and_zero_attempt_consumption",
    "ingest_parallelism": "GitHub_independent_from_semantic_buffer_traversal",
    "production_enabled": false,
    "assembly_result_schema": "config/dossier_async_assembly_result_v1.schema.json",
    "research_transport_identity": [
      "research_marker_anchor_commit",
      "research_package_git_commit",
      "research_package_path",
      "research_package_blob_sha",
      "research_package_raw_sha256",
      "research_package_sha256",
      "research_prepared_work_path",
      "research_prepared_work_blob_sha",
      "assembly_plan_blob_sha"
    ]
  },
  "implementation_scope": "inactive_offline_GitHub_preauthorization_and_eventual_per_item_chain_validation_only",
  "forbidden": [
    "new_scheduled_task",
    "semantic_worker",
    "production_queue_change",
    "canonical_Dossier_validator_change",
    "one_stage_Dossier_source_or_state_change",
    "commercial_refresh_change",
    "Deep_Fast_rank_translation_UI_change"
  ]
}
