{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2",
  "version": 2,
  "status": "active",
  "contract_revision": "prepublication-privacy-guard-2026-09-17",
  "parent_control_plane_contract": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "worker_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V2",
  "worker_schema_version": 2,
  "dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V2",
  "dossier_schema_version": 2,
  "worker_prompt_revision": "web-evidence-v2-prepublication-v1",
  "purpose": "Define the active semantic evidence policy for neutral Taste dossiers while leaving GitHub-owned scope, buffered transport, validation/persistence ownership, recovery and completeness in the existing control-plane contract.",
  "supersedes": {
    "steam_appreviews_required": false,
    "steam_cursor_required": false,
    "fixed_review_lane_counts_required": false,
    "legacy_parent_sampling_policy_is_active_semantic_contract": false,
    "ordinary_multi_source_player_feedback_web_research_is_active": true
  },
  "identity": {
    "required_work_binding": ["exact_descriptor_title", "exact_descriptor_appid"],
    "required_research_identity": ["title", "release_year"],
    "release_year_source": "reliable_public_metadata_resolved_by_semantic_worker",
    "additional_corroborators_when_needed": ["developer", "publisher", "platform", "version", "appid", "other_identifier"],
    "appid_corroborator_required_when_available_in_work_item": true,
    "ambiguous_identity_behavior": "fail_closed_no_dossier",
    "cross_release_combination_forbidden": true
  },
  "source_policy": {
    "player_feedback_source_types": [
      "steam_reviews",
      "steam_community",
      "reddit",
      "forum",
      "store_user_reviews",
      "community_discussion",
      "other_player_feedback"
    ],
    "context_only_source_types": ["official_metadata", "professional_context"],
    "professional_context_may_substitute_for_player_feedback": false,
    "prefer_multiple_independent_player_sources_when_practical": true,
    "single_source_allowed_only_with_compact_reason": true,
    "raw_review_or_post_bodies_may_be_persisted": false,
    "aggregate_storefront_statistics_are_player_feedback_mentions": false,
    "aggregate_storefront_statistics_may_raise_recurrence": false,
    "steam_store_app_page_is_player_feedback_record": false,
    "steam_store_language_parameter_is_player_feedback_evidence": false
  },
  "compact_provenance": {
    "author_identity_allowed": false,
    "profile_scoped_urls_allowed": false,
    "review_or_post_content_in_locator_metadata_allowed": false,
    "raw_body_or_body_like_fields_allowed": false,
    "public_ref_url_text_allowed": false,
    "forbidden_profile_url_path_regexes": [
      "^/(?:id|profiles?|users?|u|authors?)/[^/]+(?:/|$)"
    ],
    "forbidden_profile_url_query_keys": [
      "author",
      "author_id",
      "user",
      "user_id",
      "userid",
      "username",
      "profile",
      "profile_id",
      "steamid"
    ],
    "forbidden_public_ref_regexes": [
      "\\b(?:contribution|comment|post|review|entry|record)\\s+by\\s+[^,;]+",
      "\\b(?:username|display[ _-]?name|author|contributor|profile)\\s*[:=]",
      "(?<![A-Za-z0-9_])@[A-Za-z0-9_][A-Za-z0-9_.-]{1,}",
      "\\b(?:u|user)/[A-Za-z0-9_][A-Za-z0-9_.-]{1,}",
      "\\b(?:summarized|summarised|summary)\\s+(?:as|:)"
    ],
    "neutral_locator_examples": [
      "Steam discussion 729153699965901699 opening contribution, 2026-01-19",
      "Hellish Quart Steam negative review posted 2025-12-20, 101.7h record",
      "reddit-thread:ve5i0a:2022-06-17"
    ],
    "rule": "Persist only non-identifying locator metadata. Author/display identity and review/post content are unnecessary for this product and must be omitted rather than pseudonymized."
  },
  "prepublication_validation": {
    "status": "active",
    "mode": "shared_canonical_buffer_validator",
    "canonical_entrypoint": "scripts/taste_steam_review_dossier_buffered.py::validate_buffer_artifact",
    "worker_entrypoint": "scripts/taste_steam_review_dossier_prepublication.py",
    "validate_complete_group_before_create_only_publication": true,
    "independent_rule_list_forbidden": true,
    "on_validation_failure": "publish_nothing_for_group_and_stop_without_later_groups",
    "on_validator_execution_unavailable": "publish_nothing_for_group_and_stop_fail_closed",
    "canonical_truth_owner": "github_control_plane",
    "worker_check_role": "publication_guard_only"
  },
  "mention_binding": {
    "definition": "mention_count is the number of distinct attributable player-feedback records actually inspected and bound to the exact observation",
    "observation_binding_field": "player_feedback_ids",
    "record_container": "provenance.player_feedback_records",
    "count_rule": "mention_count_must_equal_number_of_distinct_bound_player_feedback_ids",
    "record_rule": "every_bound_feedback_id_must_resolve_to_one_unique_compact_player_feedback_record_whose_source_is_player_feedback_true_and_is_also_referenced_by_the_observation",
    "aggregate_count_rule": "overall_review_totals_positive_counts_language_filtered_counts_percentages_ratings_curator_totals_and_other_aggregate_statistics_never_create_feedback_records_or_mentions",
    "one_record_rule": "one_attributable_player_feedback_record_requires_anecdotal_recurrence_and_mention_count_1",
    "raw_body_storage": false
  },
  "recency": {
    "search_recent_first": true,
    "recent_target": "prefer_feedback_from_the_last_12_months_when_available_then_expand_if_sparse",
    "current_state_topics": ["bugs", "performance", "compatibility", "technical_state", "localization", "regional_service_state"],
    "current_state_requires_recent_support": true,
    "recent_evidence_dominates_old_evidence_for_current_state": true,
    "launch_only_issue_with_recent_fix_or_material_reduction": "historical",
    "old_feedback_remains_valid_for": ["gameplay", "story", "pacing", "structure", "progression", "repetition", "difficulty", "durable_friction"],
    "conflicting_or_insufficient_temporal_evidence": "uncertain"
  },
  "russian_evidence": {
    "attempt_required": true,
    "statuses": [
      "found_and_used",
      "searched_not_found_or_insufficient",
      "source_access_unavailable"
    ],
    "priority_topics": ["localization", "translation", "voice", "font", "encoding", "regional_service"],
    "found_and_used_rule": "requires_at_least_one_attributable_russian_or_mixed_language_player_feedback_record_bound_to_an_observation",
    "steam_store_russian_ui_rule": "store_page_rendered_in_russian_or_with_l_russian_is_context_only_and_cannot_satisfy_found_and_used_or_multi_source_without_an_attributable_player_feedback_record",
    "aggregate_only_search_result": "searched_not_found_or_insufficient",
    "russian_specific_claim_rule": "do_not_infer_localization_translation_voice_font_encoding_or_regional_findings_from_non_russian_feedback",
    "fabrication_forbidden": true
  },
  "adaptive_research": {
    "strategy": "adaptive_multi_source_web",
    "semantic_worker_decides_sufficiency": true,
    "expand_when": ["evidence_sparse", "source_divergent", "temporal_conflict", "localization_specific", "identity_ambiguous"],
    "stop_when": "additional_search_is_unlikely_to_materially_change_the_dossier",
    "accepted_stop_reasons": ["evidence_stable", "bounded_limit_reached"],
    "hard_bounds_per_game": {
      "max_web_search_queries": 8,
      "max_opened_or_read_source_pages": 16
    },
    "critical_insufficiency_behavior": "fail_closed_no_dossier",
    "fixed_review_count_or_cursor_requirement": false
  },
  "accepted_evidence_statuses": ["current", "historical", "durable", "uncertain"],
  "migration": {
    "legacy_dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V1",
    "legacy_dossier_accepted_as_web_evidence_v2": false,
    "legacy_zero_evidence_or_store_only_placeholder_accepted": false,
    "prior_web_evidence_v1_binding_accepted_as_v2": false,
    "fresh_legacy_cache_rule": "treat_as_incompatible_and_rebuild_when_next_canonically_evaluated_for_freshness",
    "same_day_fixed_snapshot_rule": "an_incompatible_worker_evidence_binding_or_canonical_group_size_requires_a_normal_github_owned_snapshot_rebuild_even_on_the_same_calendar_date",
    "stale_buffer_rule": "old_snapshot_or_old_group_plan_buffer_artifacts_can_never_be_rebound_to_the_new_snapshot",
    "manual_progress_migration_forbidden": true
  }
}
