{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V1",
  "version": 1,
  "status": "active",
  "contract_revision": "web-evidence-redesign-2026-09-15",
  "parent_control_plane_contract": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "worker_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V2",
  "worker_schema_version": 2,
  "dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V2",
  "dossier_schema_version": 2,
  "worker_prompt_revision": "web-evidence-v1",
  "purpose": "Define the active semantic evidence policy for neutral Taste dossiers while leaving GitHub-owned scope, buffered transport, validation/persistence ownership, recovery and completeness in the existing control-plane contract.",
  "supersedes": {
    "steam_appreviews_required": false,
    "steam_cursor_required": false,
    "fixed_review_lane_counts_required": false,
    "legacy_parent_sampling_policy_is_active_semantic_contract": false,
    "ordinary_multi_source_player_feedback_web_research_is_active": true
  },
  "identity": {
    "required_work_binding": ["exact_descriptor_title", "exact_descriptor_appid"],
    "required_research_identity": ["title", "release_year"],
    "release_year_source": "reliable_public_metadata_resolved_by_semantic_worker",
    "additional_corroborators_when_needed": ["developer", "publisher", "platform", "version", "appid", "other_identifier"],
    "appid_corroborator_required_when_available_in_work_item": true,
    "ambiguous_identity_behavior": "fail_closed_no_dossier",
    "cross_release_combination_forbidden": true
  },
  "source_policy": {
    "player_feedback_source_types": [
      "steam_reviews",
      "steam_community",
      "reddit",
      "forum",
      "store_user_reviews",
      "community_discussion",
      "other_player_feedback"
    ],
    "context_only_source_types": ["official_metadata", "professional_context"],
    "professional_context_may_substitute_for_player_feedback": false,
    "prefer_multiple_independent_player_sources_when_practical": true,
    "single_source_allowed_only_with_compact_reason": true,
    "raw_review_or_post_bodies_may_be_persisted": false
  },
  "recency": {
    "search_recent_first": true,
    "recent_target": "prefer_feedback_from_the_last_12_months_when_available_then_expand_if_sparse",
    "current_state_topics": ["bugs", "performance", "compatibility", "technical_state", "localization", "regional_service_state"],
    "current_state_requires_recent_support": true,
    "recent_evidence_dominates_old_evidence_for_current_state": true,
    "launch_only_issue_with_recent_fix_or_material_reduction": "historical",
    "old_feedback_remains_valid_for": ["gameplay", "story", "pacing", "structure", "progression", "repetition", "difficulty", "durable_friction"],
    "conflicting_or_insufficient_temporal_evidence": "uncertain"
  },
  "russian_evidence": {
    "attempt_required": true,
    "statuses": [
      "found_and_used",
      "searched_not_found_or_insufficient",
      "source_access_unavailable"
    ],
    "priority_topics": ["localization", "translation", "voice", "font", "encoding", "regional_service"],
    "fabrication_forbidden": true
  },
  "adaptive_research": {
    "strategy": "adaptive_multi_source_web",
    "semantic_worker_decides_sufficiency": true,
    "expand_when": ["evidence_sparse", "source_divergent", "temporal_conflict", "localization_specific", "identity_ambiguous"],
    "stop_when": "additional_search_is_unlikely_to_materially_change_the_dossier",
    "accepted_stop_reasons": ["evidence_stable", "bounded_limit_reached"],
    "hard_bounds_per_game": {
      "max_web_search_queries": 8,
      "max_opened_or_read_source_pages": 16
    },
    "critical_insufficiency_behavior": "fail_closed_no_dossier",
    "fixed_review_count_or_cursor_requirement": false
  },
  "accepted_evidence_statuses": ["current", "historical", "durable", "uncertain"],
  "migration": {
    "legacy_dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V1",
    "legacy_dossier_accepted_as_web_evidence_v2": false,
    "legacy_zero_evidence_or_store_only_placeholder_accepted": false,
    "fresh_legacy_cache_rule": "treat_as_incompatible_and_rebuild_when_next_canonically_evaluated_for_freshness",
    "same_day_fixed_snapshot_rule": "control_plane_snapshot_and_group_plan_may_be_preserved_while_worker_contract_binding_is_upgraded_additively",
    "current_invalid_buffered_g1_g2_rule": "leave_untouched_for_separate_coordinated_recovery_and_acceptance"
  }
}
