{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2",
  "version": 2,
  "status": "active",
  "contract_revision": "contract-contradictions-fix-2026-09-18",
  "parent_control_plane_contract": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "parallel_validation_contract": "TASTE-STEAM-REVIEW-DOSSIER-PARALLEL-VALIDATION-CONTRACT-V1",
  "worker_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V2",
  "worker_schema_version": 2,
  "dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V2",
  "dossier_schema_version": 2,
  "worker_prompt_revision": "web-evidence-v2-steam-russian-review-retrieval-improvement-v1",
  "purpose": "Define the active semantic evidence policy for neutral Taste dossiers while leaving GitHub-owned scope, buffered transport, asynchronous strict validation/persistence, recovery and completeness in the existing control-plane contracts.",
  "supersedes": {
    "steam_appreviews_required": false,
    "steam_cursor_required": false,
    "fixed_review_lane_counts_required": false,
    "legacy_parent_sampling_policy_is_active_semantic_contract": false,
    "ordinary_multi_source_player_feedback_web_research_is_active": true
  },
  "identity": {
    "required_work_binding": [
      "exact_descriptor_title",
      "exact_descriptor_appid"
    ],
    "required_research_identity": [
      "title",
      "release_year"
    ],
    "release_year_source": "reliable_public_metadata_resolved_by_semantic_worker",
    "additional_corroborators_when_needed": [
      "developer",
      "publisher",
      "platform",
      "version",
      "appid",
      "other_identifier"
    ],
    "appid_corroborator_required_when_available_in_work_item": true,
    "ambiguous_identity_behavior": "fail_closed_no_dossier",
    "cross_release_combination_forbidden": true,
    "steam_player_feedback_url_appid_must_match_exact_dossier_appid_when_exposed": true,
    "base_game_feedback_may_satisfy_dlc_gate": false
  },
  "source_policy": {
    "player_feedback_source_types": [
      "steam_reviews",
      "steam_community",
      "reddit",
      "forum",
      "store_user_reviews",
      "community_discussion",
      "other_player_feedback"
    ],
    "context_only_source_types": [
      "official_metadata",
      "professional_context"
    ],
    "professional_context_may_substitute_for_player_feedback": false,
    "prefer_multiple_independent_player_sources_when_practical": true,
    "single_source_allowed_only_with_compact_reason": true,
    "raw_review_or_post_bodies_may_be_persisted": false,
    "aggregate_storefront_statistics_are_player_feedback_mentions": false,
    "aggregate_storefront_statistics_may_raise_recurrence": false,
    "steam_store_app_page_is_player_feedback_record": false,
    "steam_store_language_parameter_is_player_feedback_evidence": false,
    "source_diversity_identity": "canonicalized_physical_source_locator_not_worker_source_id",
    "steam_store_exact_app_review_collection_may_be_fallback_parent": true,
    "fallback_parent_is_not_itself_a_feedback_record_or_mention": true,
    "steam_store_parent_feedback_surface_mode": "concrete_item_collection",
    "steam_store_parent_player_feedback_flag_semantics": "surface_contains_inspected_player_feedback_children_not_page_as_feedback_item",
    "steam_store_parent_aggregate_metadata_is_feedback": false,
    "steam_store_parent_aggregate_metadata_may_satisfy_russian_found_and_used": false
  },
  "compact_provenance": {
    "author_identity_allowed": false,
    "profile_scoped_urls_allowed": false,
    "review_or_post_content_in_locator_metadata_allowed": false,
    "raw_body_or_body_like_fields_allowed": false,
    "public_ref_url_text_allowed": false,
    "forbidden_profile_url_path_regexes": [
      "^/(?:id|profiles?|users?|u|authors?)/[^/]+(?:/|$)"
    ],
    "forbidden_profile_url_query_keys": [
      "author",
      "author_id",
      "user",
      "user_id",
      "userid",
      "username",
      "profile",
      "profile_id",
      "steamid"
    ],
    "forbidden_public_ref_regexes": [
      "\\b(?:contribution|comment|post|review|entry|record)\\s+by\\s+[^,;]+",
      "\\b(?:username|display[ _-]?name|author|contributor|profile)\\s*[:=]",
      "(?<![A-Za-z0-9_])@[A-Za-z0-9_][A-Za-z0-9_.-]{1,}",
      "\\b(?:u|user)/[A-Za-z0-9_][A-Za-z0-9_.-]{1,}",
      "\\b(?:summarized|summarised|summary)\\s+(?:as|:)"
    ],
    "neutral_locator_examples": [
      "steam-discussion:729153699965901699:comment-442019",
      "steam-recommendation:185290437",
      "reddit-comment:ve5i0a:k3mz12"
    ],
    "rule": "Persist only non-identifying locator/provenance metadata. Author/display identity, SteamID/account/profile identity and direct hashes or predictable pseudonyms derived from them must never persist. A transient author identity may be read only in worker memory to dedupe concrete fallback items before serialization.",
    "direct_author_identity_hash_as_anonymization_allowed": false,
    "transient_author_identity_use": "dedupe_only_within_current_worker_run_and_current_product",
    "transient_author_identity_persistence_allowed": false,
    "internal_join_ids": {
      "source_id_pattern": "^source-[0-9]{3}$",
      "stable_feedback_id_pattern": "^feedback-[0-9]{3}$",
      "fallback_feedback_id_pattern": "^fallback-[0-9]{3}$",
      "assignment": "sequential_dossier_local_join_keys_in_serialized_record_order_by_namespace",
      "author_identity_independent": true,
      "direct_hash_or_predictable_author_pseudonym_forbidden": true,
      "stable_item_identity_source": "validated_safe_item_url_or_public_ref_not_internal_join_id"
    }
  },
  "feedback_item_identity": {
    "definition": "one player-feedback record using the preferred persisted stable non-identifying item locator, or a dossier-local opaque transient-author-deduped fallback record when a concrete item was actually inspected on an exact-product player-feedback collection but no acceptable neutral item locator was obtainable",
    "url_normalization": [
      "lowercase_and_www_normalize_host",
      "collapse_repeated_path_slashes",
      "ignore_trailing_path_slash",
      "drop_fragment",
      "drop_utm_and_known_tracking_query_parameters",
      "sort_remaining_query_parameters"
    ],
    "public_ref_rule": "must be a stable machine-like or explicit review/post/comment/thread/item locator token; human date/playtime descriptions alone are not item identities",
    "collection_surfaces_forbidden_as_feedback_records": true,
    "known_collection_examples": [
      "steam_app_reviews_list",
      "steam_discussions_index_without_thread_item",
      "reddit_subreddit_index",
      "search_result_page",
      "generic_reviews_or_index_page"
    ],
    "duplicate_alias_rule": "two feedback records resolving to the same canonical physical item identity are one item and the dossier is invalid rather than double-counted",
    "source_alias_rule": "obvious URL/public_ref aliases resolving to one parent player source cannot create source diversity",
    "distinct_valid_items_same_thread_allowed": true,
    "preferred_identity_order": [
      "stable_locator",
      "transient_author_deduped"
    ],
    "stable_locator_rule": "stable_locator remains the preferred and strongest path and retains all existing item-level URL/public_ref physical-identity validation",
    "fallback_forbidden_when_neutral_item_locator_available": true,
    "collection_surface_fallback_parent_allowed_only_for_concrete_inspected_items": true,
    "steam_store_exact_app_parent_allowed_for_identity_mode": "transient_author_deduped",
    "steam_store_exact_app_parent_allowed_for_stable_locator": false,
    "stable_internal_join_id_rule": "stable feedback_id is a sequential dossier-local feedback-NNN key only; physical identity remains in the validated safe item URL/public_ref"
  },
  "parent_item_binding": {
    "rule": "every player_feedback_record must resolve to the physical surface represented by its parent source_id rather than merely sharing a host",
    "reddit_rule": "when parent and child locators expose a subreddit or thread identity, the child subreddit must equal the parent subreddit and a parent thread id must equal the child thread id; distinct stable child items inside that same thread remain valid",
    "steam_surface_rule": "Steam review/recommendation items must not be bound under an explicitly discussion parent surface and Steam discussion items must not be bound under an explicitly review parent surface",
    "public_ref_surface_rule": "stable public_ref namespaces such as steam-recommendation, steam-review, steam-discussion and reddit-comment are reconciled with the parent source type/locator",
    "host_match_alone_is_sufficient": false,
    "same_thread_distinct_items_allowed": true,
    "unknown_generic_surface_behavior": "retain_existing_host_and_item_level_guards_when_no_supported_surface_identity_can_be_deterministically_resolved",
    "steam_exact_product_rule": "for stable_locator Steam children, any deterministically exposed Steam appid in child URL/public_ref must equal the exact dossier appid",
    "steam_container_rule": "when both Steam parent and stable child expose deterministically resolvable discussion/container identity, every commonly exposed container/thread component must match; host or surface-class match alone is insufficient"
  },
  "prepublication_validation": {
    "status": "not_required_for_scheduled_worker",
    "mode": "github_postpublication_canonical_validation",
    "canonical_entrypoint": "scripts/taste_steam_review_dossier_buffered.py::validate_buffer_artifact",
    "worker_entrypoint": "scripts/taste_steam_review_dossier_prepublication.py",
    "worker_entrypoint_role": "ci_developer_optional_parity_utility_only",
    "validate_complete_group_before_create_only_publication": false,
    "scheduled_worker_python_execution_required": false,
    "scheduled_worker_manual_validator_required": false,
    "candidate_publication_rule": "publish_the_complete_predeclared_group_create_only_without_waiting_for_github_validation_or_canonical_acceptance",
    "github_validation_after_candidate_write_required": true,
    "github_validation_status_contract": "TASTE-STEAM-REVIEW-DOSSIER-PARALLEL-VALIDATION-CONTRACT-V1",
    "on_github_validation_failure": "candidate_remains_immutable_buffered_and_canonical_progress_stops_at_the_invalid_expected_group_without_promoting_later_groups",
    "independent_rule_list_forbidden": true,
    "canonical_truth_owner": "github_control_plane",
    "worker_check_role": "none_required_at_scheduled_runtime"
  },
  "mention_binding": {
    "definition": "mention_count is the number of distinct bound player-feedback records actually inspected and bound to the exact observation or conflict; stable-locator records are independently reopenable, while transient-author-deduped fallback records are dossier-local and lower-auditability",
    "observation_binding_field": "player_feedback_ids",
    "conflict_binding_field": "player_feedback_ids",
    "record_container": "provenance.player_feedback_records",
    "count_rule": "mention_count_must_equal_number_of_distinct_bound_player_feedback_ids_after_physical_item_identity_validation",
    "record_rule": "every_bound_feedback_id_must_resolve_to_one_unique_compact_player_feedback_record_whose_source_is_player_feedback_true_and_is_also_referenced_by_the_observation_or_conflict;stable_locator_records_require_physical_item_identity_and_transient_author_deduped_records_require_the_explicit_fallback_contract",
    "aggregate_count_rule": "overall_review_totals_positive_counts_language_filtered_counts_percentages_ratings_curator_totals_and_other_aggregate_statistics_never_create_feedback_records_or_mentions",
    "one_record_rule": "one_attributable_player_feedback_record_requires_anecdotal_recurrence_and_mention_count_1",
    "raw_body_storage": false,
    "recurrence_identity_strength": {
      "anecdotal": "exactly_1_total_bound_record",
      "limited": "at_least_2_total_distinct_bound_records",
      "moderate": "at_least_3_bound_stable_locator_records",
      "strong": "at_least_5_bound_stable_locator_records",
      "fallback_only_cap": "limited",
      "mixed_rule": "fallback_records_count_toward_total_mentions_and_can_help_reach_limited_but_never_count_toward_the_stable_locator_threshold_for_moderate_or_strong"
    }
  },
  "language_binding": {
    "record_language_source": "provenance.player_feedback_records[].language",
    "observation_binding_field": "player_feedback_ids",
    "observation_summary_field": "evidence_languages",
    "conflict_binding_field": "player_feedback_ids",
    "conflict_language_summary_field": null,
    "bind_records_before_language_summary": true,
    "observation_summary_is_free_form": false,
    "record_language_support_projection": {
      "russian": [
        "russian"
      ],
      "non_russian": [
        "non_russian"
      ],
      "mixed": [
        "russian",
        "non_russian"
      ],
      "unknown": [
        "unknown"
      ]
    },
    "parent_source_language_containment": {
      "russian_child_requires_parent_language": [
        "russian",
        "mixed"
      ],
      "non_russian_child_requires_parent_language": [
        "non_russian",
        "mixed"
      ],
      "mixed_or_unknown_child_additional_constraint": false
    },
    "observation_summary_rule": "evidence_languages must equal the ordered distinct union of record_language_support_projection for exactly the player_feedback_ids bound to that observation",
    "canonical_output_order": [
      "russian",
      "non_russian",
      "unknown"
    ],
    "mixed_summary_token_policy": "do_not_emit_mixed_as_an_observation_summary_token; mixed is a feedback-record input language that deterministically expands to russian and non_russian support",
    "russian_claim_rule": "russian may appear in an observation language summary only when at least one bound player-feedback record language is russian or mixed",
    "non_russian_claim_rule": "non_russian may appear in an observation language summary only when at least one bound player-feedback record language is non_russian or mixed",
    "unknown_claim_rule": "unknown may appear only when at least one bound player-feedback record language is unknown and must not be used as a substitute for russian or non_russian support",
    "search_attempt_is_language_evidence": false,
    "source_page_or_locale_is_language_evidence": false,
    "conflict_statement_rule": "conflicts have no separate language-summary field; any Russian/non-Russian population or language-evidence assertion in conflict.statement must be supported by the languages of that conflict's exact bound player_feedback_ids using the same projection",
    "generation_order": [
      "classify_each_feedback_record_language",
      "bind_exact_player_feedback_ids_to_observation_or_conflict",
      "derive_language_support_only_from_those_bound_records",
      "write_observation_evidence_languages_or_language-specific_conflict_wording"
    ],
    "strict_exact_equality_required": true
  },
  "conflicts": {
    "model": "player_feedback_bound_recurrence",
    "required_fields": [
      "statement",
      "recurrence",
      "mention_count",
      "source_ids",
      "player_feedback_ids"
    ],
    "count_and_recurrence_rules": "same_as_observations",
    "official_or_professional_context_may_support_interpretation": true,
    "official_or_professional_context_alone_may_establish_recurrence": false,
    "physical_item_alias_and_source_diversity_rules_apply": true,
    "exact_duplicate_objects_allowed": false
  },
  "summary_binding": {
    "mode": "mechanically_derived_from_validated_structured_findings",
    "free_form_summary_allowed": false,
    "canonical_format": "Evidence summary: {observation_count} validated structured observations; consult observations and conflicts for supported findings.",
    "observation_count_source": "final_validated_observations_array_length",
    "new_factual_claims_allowed": false,
    "observation_or_conflict_body_repeated_in_summary": false,
    "reason": "the full structured dossier already carries all observations and conflicts; the top-level summary is only a deterministic compact pointer and cannot become a second factual authority"
  },
  "overall_strength_binding": {
    "source": "observations_only_for_strong_and_moderate_thresholds",
    "strong_rule": "overall_strength=strong requires at least one observation with recurrence=strong",
    "moderate_rule": "overall_strength=moderate requires at least one observation with recurrence=moderate or strong",
    "conflict_recurrence_promotes_overall_strength": false,
    "strong_conflict_only_rule": "a strong conflict does not by itself permit overall_strength=strong",
    "scope": "preserve_existing_strict_semantics_without_redesigning_limited_or_conflicted_scoring"
  },
  "recency": {
    "search_recent_first": true,
    "recent_target": "prefer_feedback_from_the_last_12_months_when_available_then_expand_if_sparse",
    "recent_max_age_days": 365,
    "dated_source_rule": "when publication_date is known, freshness must be recent at age <=365 days and older at age >365 days relative to generated_at_utc date",
    "undated_source_rule": "publication_date=null remains allowed; freshness then remains a worker evidence classification and current_state still requires recent",
    "known_child_date_parent_coherence_rule": "when a bound feedback record has a known date older than recent_max_age_days, its parent player source must not be labeled freshness=recent or used as current_state support merely because the parent publication_date is null",
    "unknown_child_date_behavior": "when the feedback record publication_date is genuinely null, preserve the existing undated source/item path without inventing a date",
    "current_state_topics": [
      "bugs",
      "performance",
      "compatibility",
      "technical_state",
      "localization",
      "regional_service_state"
    ],
    "current_state_requires_recent_support": true,
    "recent_evidence_dominates_old_evidence_for_current_state": true,
    "launch_only_issue_with_recent_fix_or_material_reduction": "historical",
    "old_feedback_remains_valid_for": [
      "gameplay",
      "story",
      "pacing",
      "structure",
      "progression",
      "repetition",
      "difficulty",
      "durable_friction"
    ],
    "conflicting_or_insufficient_temporal_evidence": "uncertain"
  },
  "russian_evidence": {
    "attempt_required": true,
    "statuses": [
      "found_and_used",
      "searched_no_existence_signal",
      "existence_established_retrieval_unresolved",
      "existence_established_access_unresolved"
    ],
    "complete_dossier_allowed_states": [
      "found_and_used",
      "searched_no_existence_signal"
    ],
    "priority_topics": [
      "localization",
      "translation",
      "voice",
      "font",
      "encoding",
      "regional_service"
    ],
    "found_and_used_rule": "requires_at_least_one_bound Russian-or-mixed player-feedback record that is either a valid stable_locator item or a valid transient_author_deduped concrete fallback item",
    "inverse_rule": "if_any_russian_or_mixed_player_feedback_record_is_actually_bound_to_an_observation_or_conflict_russian_attempt_must_be_found_and_used",
    "no_existence_signal_rule": "searched_no_existence_signal_is_allowed_only_after_bounded_good_faith_search_finds_no_reliable_exact_product_player_feedback_existence_signal_and_no_russian_or_mixed_record_is_bound",
    "retrieval_unresolved_rule": "if_reliable_exact_product_russian_player_feedback_existence_is_established_but_no_contract_usable_attributable_item_level_russian_or_mixed_record_is_obtained_within_hard_bounds_classify_existence_established_retrieval_unresolved_and_do_not_publish_a_complete_dossier",
    "access_unresolved_rule": "if_reliable_exact_product_russian_player_feedback_existence_is_established_but_access_to_required_player_feedback_surface_prevents_item_level_resolution_classify_existence_established_access_unresolved_and_do_not_publish_a_complete_dossier",
    "existence_signal_definition": "reliable_exact_product_or_exact_appid_player_activity_evidence_such_as_nonzero_language_review_population_or_exact_product_community_player_activity;signal_is_discovery_state_only_not_player_feedback_record",
    "existence_signal_exact_identity_required": true,
    "russian_rendered_ui_alone_is_existence_signal": false,
    "professional_russian_content_is_player_feedback_existence_signal": false,
    "professional_russian_content_may_substitute_for_player_feedback": false,
    "existence_signal_is_player_feedback_record": false,
    "existence_signal_may_create_mention_count": false,
    "existence_signal_may_raise_recurrence": false,
    "existence_signal_may_support_observation_or_conflict": false,
    "steam_store_russian_ui_rule": "store_page_rendered_in_russian_or_with_l_russian_is_context_only_and_cannot_prove_player_feedback_existence_or_satisfy_found_and_used",
    "russian_specific_claim_rule": "do_not_infer_localization_translation_voice_font_encoding_or_regional_findings_from_non_russian_feedback",
    "fabrication_forbidden": true,
    "fallback_rule": "a_valid_russian_or_mixed_transient_author_deduped_record_may_satisfy_found_and_used;aggregate_counts_or_collection_pages_without_a_concrete_item_still_cannot"
  },
  "compatibility_binding": {
    "snapshot_binding_must_include": [
      "schema_and_version_names",
      "schema_revision",
      "schema_content_sha256",
      "contract_revision",
      "contract_content_sha256",
      "worker_prompt_revision",
      "worker_prompt_content_sha256"
    ],
    "dossier_must_copy_exact_binding": true,
    "worker_index_and_each_group_descriptor_must_expose_exact_binding": true,
    "same_day_binding_change_requires_github_owned_fresh_snapshot": true,
    "old_binding_dossier_reuse_forbidden": true,
    "old_snapshot_buffer_rebinding_forbidden": true
  },
  "adaptive_research": {
    "strategy": "adaptive_multi_source_web",
    "semantic_worker_decides_sufficiency": true,
    "expand_when": [
      "evidence_sparse",
      "source_divergent",
      "temporal_conflict",
      "localization_specific",
      "identity_ambiguous"
    ],
    "stop_when": "additional_search_is_unlikely_to_materially_change_the_dossier",
    "accepted_stop_reasons": [
      "evidence_stable",
      "bounded_limit_reached"
    ],
    "hard_bounds_per_game": {
      "max_web_search_queries": 8,
      "max_opened_or_read_source_pages": 16
    },
    "critical_insufficiency_behavior": "fail_closed_no_dossier",
    "fixed_review_count_or_cursor_requirement": false,
    "russian_discovery": {
      "exact_identity_query": "use_exact_descriptor_title_plus_release_year_and_or_exact_appid",
      "russian_query_variants_required": true,
      "site_specific_escalation": "if_ordinary_search_does_not_resolve_the_russian_attempt_and_budget_remains_try_a_relevant_site_specific_player_feedback_or_community_search",
      "steam_community_guidance": "exact_product_steam_community_discussion_or_review_surfaces_are_a_natural_option_when_they_exist",
      "after_existence_signal": "direct_remaining_bounded_search_toward_contract_usable_attributable_item_level_russian_or_mixed_records_instead_of_repeating_aggregate_or_list_lookups",
      "fixed_source_quota": false,
      "bounds_are_safety_ceilings_not_targets": true,
      "retrieval_diversification": {
        "phase_trigger": "reliable_exact_product_russian_player_feedback_existence_established_and_no_usable_russian_or_mixed_item_yet",
        "goal": "obtain_contract_usable_attributable_item_level_russian_or_mixed_player_feedback_without_weakening_exact_product_identity",
        "surface_class_examples": [
          "steam_community_or_user_review_items",
          "reddit_exact_product_threads_or_comments",
          "public_russian_language_game_forums",
          "public_community_discussions_or_comment_threads",
          "public_store_user_review_items",
          "pikabu_or_analogous_public_user_generated_discussions",
          "other_credible_public_player_feedback"
        ],
        "first_failed_surface_rule": "if_the_first_reasonable_retrieval_surface_yields_only_aggregate_list_non_item_or_otherwise_unusable_evidence_and_query_or_page_budget_remains_the_worker_must_try_at_least_one_materially_different_public_player_feedback_surface_class_when_reasonably_discoverable",
        "continued_diversification_rule": "after_the_first_materially_different_surface_if_retrieval_is_still_unresolved_and_budget_remains_continue_adaptively_to_the_most_promising_reasonably_discoverable_distinct_player_feedback_surface_classes_until_a_usable_item_is_found_a_hard_bound_is_reached_or_no_reasonably_discoverable_distinct_surface_class_remains",
