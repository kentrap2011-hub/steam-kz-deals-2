    "stage2_calibrated_deep_fit": {
      "minimum": 0,
      "maximum": 56,
      "ranking_authority_after_cutover": true,
      "semantic_owner": "deep_stage2_worker_for_relative_judgment",
      "numeric_placement_owner": "github_control_plane",
      "canonical_storage_precision_decimal_places": 2,
      "canonical_display_precision_decimal_places": 2,
      "integer_only_forbidden": true,
      "active_ranked_fit_scores_must_be_unique": true,
      "monotonic_rule": "If A is canonically placed above B, A.calibrated_deep_fit_score_0_56 must be numerically greater than B.calibrated_deep_fit_score_0_56.",
      "precision_rationale": "0.01 creates 5601 positions and at least 101 positions inside any one-point interval, enough to maintain a strict local order for roughly 100 active candidates without large artificial gaps.",
      "semantic_interpretation": "The final number is a human-readable coordinate of the comparative order, not measurement precision."
    },
    "wishlist": {
      "owner": "github_control_plane",
      "values": [
        0,
        4
      ],
      "source": "current exact Steam wishlist state",
      "semantic_workers_may_change": false
    },
    "personal_quality": {
      "formula": "calibrated_deep_fit_score_0_56 + wishlist_bonus_0_or_4",
      "minimum": 0,
      "maximum": 60,
      "owner": "github_control_plane"
    },
    "purchase": {
      "minimum": 0,
      "maximum": 40,
      "owner": "github_control_plane",
      "source_contract_during_freeze": "config/final_ranking_policy.json",
      "semantic_workers_may_change": false
    },
    "combined_offer": {
      "formula": "personal_quality_score_0_60 + purchase_score_0_40",
      "minimum": 0,
      "maximum": 100,
      "owner": "github_control_plane"
    },
    "retired_after_cutover_as_independent_personal_arithmetic": [
      "achievements",
      "duration",
      "risk"
    ],
    "folded_into_stage1_semantic_context": [
      "gameplay_and_mastery",
      "development_and_variety",
      "structure_pacing_direction",
      "personal_hooks",
      "breadth_of_match",
      "duration_preference",
      "technical_and_personal_risks",
      "achievement_related_preference_when_relevant",
      "prior_direct_user_evidence",
      "interactions_between_these_factors"
    ],
    "direct_user_rating_rule": "Exact direct user ratings remain strong calibration anchors/constraints and are not converted into a hidden additive bonus."
  },
