{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROGRESSIVE-PASS2-EXECUTION-RECEIPT-V1",
  "title": "Progressive PASS 2 terminal execution submission",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "run_start_anchor_commit",
    "run_start_authority_commit",
    "run_started_at_utc",
    "semantic_generation_id",
    "profile_pin_sha256",
    "work_id",
    "family_id",
    "taste_subject_key",
    "appid",
    "taste_fingerprint",
    "candidate_context_sha256",
    "dossier_content_sha256",
    "dossier_compatibility_binding",
    "authorization_id",
    "work_mode",
    "recovery_authorization_id",
    "recovery_reason",
    "recovery_condition_binding",
    "execution_status",
    "execution_started_at_utc",
    "execution_finished_at_utc",
    "terminal_reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "PROGRESSIVE-PASS2-EXECUTION-RECEIPT-V1"
    },
    "semantic_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "taste_subject_key": {
      "type": "string",
      "minLength": 1
    },
    "appid": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "taste_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "candidate_context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "dossier_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dossier_compatibility_binding": {
      "type": "object"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_status": {
      "const": "executed_no_accepted_result"
    },
    "execution_started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "execution_finished_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "terminal_reason": {
      "enum": [
        "worker_failure",
        "evidence_unavailable",
        "insufficient_evidence",
        "base_support_unresolved",
        "terminal_execution_failure"
      ]
    },
    "work_mode": {
      "enum": [
        "normal_first_pass",
        "recovery",
        "legacy_full_reanalysis",
        "score_explainability_migration"
      ]
    },
    "recovery_authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_reason": {
      "enum": [
        "materially_changed_canonically_accepted_dossier_or_evidence",
        "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
        "explicit_canonical_github_recovery_action_with_recorded_reason",
        null
      ]
    },
    "recovery_condition_binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "profile_pin_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_start_authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_start_anchor_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "migration_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "migration_target_id",
        "migration_authority_commit",
        "migration_frozen_at_utc",
        "prior_outcome",
        "prior_fit_level",
        "prior_confidence",
        "prior_taste_factors",
        "prior_not_fit_basis",
        "prior_work_id",
        "prior_authorization_id",
        "prior_accepted_at_utc",
        "preserved_positive_evidence",
        "preserved_not_fit_evidence"
      ],
      "properties": {
        "migration_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_target_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_authority_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migration_frozen_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_outcome": {
          "enum": [
            "analyzed_fit",
            "analyzed_not_fit"
          ]
        },
        "prior_fit_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strong",
            "moderate",
            null
          ]
        },
        "prior_confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "medium",
            "high",
            null
          ]
        },
        "prior_taste_factors": {
          "type": [
            "object",
            "null"
          ]
        },
        "prior_not_fit_basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "completed_below_threshold",
            "confirmed_personal_negative",
            null
          ]
        },
        "prior_work_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_authorization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "preserved_positive_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserved_not_fit_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "score_evidence_contract": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "contract",
            "required"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "contract": {
              "const": "DEEP-SCORE-EVIDENCE-V1"
            },
            "required": {
              "const": true
            }
          }
        }
      ]
    },
    "score_migration_provenance": {
      "$ref": "#/$defs/deepScoreMigrationProvenance"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "normal_first_pass"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "recovery"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_reason": {
            "enum": [
              "materially_changed_canonically_accepted_dossier_or_evidence",
              "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
              "explicit_canonical_github_recovery_action_with_recorded_reason"
            ]
          },
          "recovery_condition_binding": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "legacy_full_reanalysis"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "required": [
          "migration_provenance"
        ],
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "normal_first_pass"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "migration_provenance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "recovery"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "migration_provenance"
          ]
        }
      }
    }
  ],
  "$defs": {
    "deepScoreMigrationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "migration_target_id",
        "migration_authority_commit",
        "migration_frozen_at_utc",
        "prior_authorization_id",
        "prior_accepted_at_utc",
        "prior_outcome",
        "prior_fit_level",
        "prior_confidence",
        "prior_taste_factors",
        "prior_positive_evidence",
        "prior_work_id"
      ],
      "properties": {
        "migration_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_target_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_authority_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migration_frozen_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_authorization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_outcome": {
          "const": "analyzed_fit"
        },
        "prior_fit_level": {
          "enum": [
            "strong",
            "moderate"
          ]
        },
        "prior_confidence": {
          "enum": [
            "medium",
            "high"
          ]
        },
        "prior_taste_factors": {
          "type": "object"
        },
        "prior_positive_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prior_work_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
