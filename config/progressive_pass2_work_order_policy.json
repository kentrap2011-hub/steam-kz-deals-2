{
  "contract": "PROGRESSIVE-PASS2-WORK-ORDER-V1",
  "status": "canonical",
  "owner": "github_control_plane",
  "scope": "normal_first_pass_for_current_eligible_unresolved_deep_candidates",
  "precedence": [
    "never_authoritatively_completed_under_any_profile_first",
    "previously_completed_oldest_last_success_at_utc_first"
  ],
  "never_completed_order": [
    "canonical_purchase_value_desc",
    "steam_global_positive_percent_desc",
    "steam_global_review_count_desc",
    "family_id_asc"
  ],
  "purchase_value": {
    "canonical_function": "priority_ranking.build_purchase_breakdown",
    "score_field": "purchase_score",
