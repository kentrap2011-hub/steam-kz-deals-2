    "source": "current_existing_progressive_candidate_context.purchase",
    "requires_no_new_network_lookup": true
  },
  "steam_review_inputs": {
    "positive_percent": "context_only.reviews.global_positive_percent",
    "review_count": "context_only.reviews.global_count",
    "missing_numeric_value": 0
  },
  "constraints": {
    "full_eligible_deep_scope_preserved": true,
    "hard_top_n": false,
    "sale_expiry_used_for_order": false,
    "changes_site_ranking": false,
    "changes_eligibility": false,
    "changes_worker_prompt": false,
    "recovery_attempts_not_reordered": true
  },
  "output": "ordered_existing_github_prepared_progressive_pass2_work_manifest"
}
