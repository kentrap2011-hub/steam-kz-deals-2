{
  "schema": "DOSSIER-TWO-STAGE-STAGING-P2-V1",
  "version": 1,
  "implemented": true,
  "active": false,
  "executable_in_production": false,
  "authoritative": false,
  "parent_contract": "config/dossier_two_stage_interfaces_contract.json",
  "github_owner": "github_actions_control_plane",
  "execution_policy": {
    "pure_planning_and_offline_isolated_fixture_writes_only": true,
    "real_repository_writes_while_gate_inactive": false,
    "worker_transport_scan_enabled": false,
    "claim_scheduler_queue_retry_added": false,
    "atomic_publication_requires_later_shared_writer_integration": true
  },
  "git_binding": {
    "assignment_source": "github_prepared_assignment_in_exact_marker_parent",
    "descriptor_source": "existing_worker_group_descriptor_in_exact_marker_parent",
    "pending_source": "existing_worker_index_in_exact_marker_parent",
    "marker_authority": "actual_single_git_parent",
    "marker_commit_change_scope": "only_create_nonce_marker",
    "research_transport": "single_parent_addition_only",
    "research_marker_must_be_first_parent_ancestor": true,
    "assembly_plan_source": "github_prepared_preauthorized_plan_in_exact_Assembly_marker_parent_for_async_V2; legacy_accepted_only_P2_remains_inactive_fixture",
    "research_acceptance_receipt_must_be_in_stage_b_marker_parent": false,
    "content_sha256": "canonical_json_sorted_keys_utf8_compact",
    "git_blob_sha": "git_object_sha_for_original_file_bytes",
    "refusal": "fail_closed_never_rebind",
    "async_handoff": "submitted_Research_exact_original_commit_bytes_blob_raw_and_canonical_SHA_binds_Assembly_candidate_no_Research_acceptance_required"
  },
  "lifecycle": {
    "research": [
      "accepted_structural_evidence",
      "rejected_invalid",
      "research_incomplete",
      "semantic_exhausted"
    ],
    "assembly": [
      "preauthorized_pending_submitted_research",
      "candidate_created_unvalidated",
      "github_item_chain_validated_pending_strict_group_ingest",
      "rejected_invalid",
      "assembly_gap",
      "runtime_blocked"
    ],
    "immutable_transitions": "research_receipt_plus_research_state_then_assembly_assignment_plus_assembly_state",
    "staging_results_are_not_canonical": true,
    "duplicate_stage_attempt": "fail_closed_no_new_receipt",
    "invalid_origin": "fail_closed_without_claiming_authoritative_receipt"
  },
  "namespaces": {
    "research_prepared": "data/control/dossier_research_assignments/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}.json",
    "research_marker": "data/control/dossier_research_run_starts/{nonce}.json",
    "research_candidate": "data/ai_inbox/dossier_research/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}.json",
    "research_acceptance": "data/control/dossier_research_accepted/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}.json",
    "research_rejection": "data/control/dossier_research_rejections/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}.json",
    "research_state": "data/control/dossier_two_stage_state/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}--research.json",
    "assembly_plan": "data/control/dossier_assembly_plans/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}.json",
    "assembly_marker": "data/control/dossier_assembly_run_starts/{nonce}.json",
    "assembly_assignment": "data/control/dossier_assembly_assignments/{snapshot_id}/g{sequence:06d}/{appid}--{assembly_assignment_id}.json",
    "assembly_state": "data/control/dossier_two_stage_state/{snapshot_id}/g{sequence:06d}/{appid}--{assignment_id}--assembly.json"
  },
  "schema_files": {
    "research_rejection": "config/dossier_research_rejection_receipt_v1.schema.json",
    "staging_state": "config/dossier_two_stage_staging_state_v1.schema.json"
  },
  "new_work_authorization": false,
  "source_project_authority": "one_stage_dossier_remains_production_owner",
  "no_scheduled_tasks": true,
  "asynchronous_buffers": {
    "contract": "config/dossier_two_stage_async_buffer_contract.json",
    "schema": "DOSSIER-TWO-STAGE-ASYNC-BUFFER-V2",
    "research_immutable_buffer": "data/control/dossier_two_stage_buffers/research/{snapshot_id}/{buffer_id}.json",
    "assembly_immutable_buffer": "data/control/dossier_two_stage_buffers/assembly/{snapshot_id}/{buffer_id}.json",
    "buffer_is_frozen_at": "actual_run_start_marker_single_git_parent",
    "worker_next_item_depends_on_prior_receipt": false,
    "worker_can_self_extend_buffer": false,
    "github_ingest_can_lag_worker_progress": true,
    "assembly_requires_research_accepted_receipt": false,
    "assembly_requires_exact_submitted_research_transport": true,
    "fixed_unresolved_slot_liveness_gate": false,
    "limits_only_future_new_github_authorizations": true,
    "github_only_retry_recovery": true,
    "no_whole_research_group_assembly_barrier": true,
    "activation": false
  }
}
