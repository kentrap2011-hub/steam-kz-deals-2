{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TASTE-STEAM-REVIEW-DOSSIER-TERMINAL-RECEIPT-V1",
  "title": "Taste Steam review dossier semantic-exhaustion terminal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "snapshot_id",
    "prepared_required_sha256",
    "group_plan_sha256",
    "group_count",
    "web_evidence_contract_binding",
    "sequence",
    "start_index",
    "end_index_exclusive",
    "appids",
    "items_sha256",
    "scope_source",
    "source_queue_sha256",
    "items",
    "group_sha256",
    "execution_status",
    "semantic_stop_class",
    "valid_dossier_produced",
    "normal_first_pass_attempt_consumed",
    "blocked_game",
    "route_exhaustion"
  ],
  "properties": {
    "schema": {
      "const": "TASTE-STEAM-REVIEW-DOSSIER-TERMINAL-RECEIPT-V1"
    },
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prepared_required_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group_count": {
      "type": "integer",
      "minimum": 1
    },
    "web_evidence_contract_binding": {
      "type": "object"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "start_index": {
      "type": "integer",
      "minimum": 0
    },
    "end_index_exclusive": {
      "type": "integer",
      "minimum": 1
    },
    "appids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    },
    "items_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_source": {
      "type": "string",
      "minLength": 1
    },
    "source_queue_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "group_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_status": {
      "const": "semantic_exhaustion_no_valid_dossier"
    },
    "semantic_stop_class": {
      "enum": [
        "existence_established_retrieval_unresolved",
        "existence_established_access_unresolved",
        "critical_evidence_insufficient_after_required_routes_exhausted"
      ]
    },
    "valid_dossier_produced": {
      "const": false
    },
    "normal_first_pass_attempt_consumed": {
      "const": true
    },
    "blocked_game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appid",
        "title"
      ],
      "properties": {
        "appid": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "route_exhaustion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "russian",
        "source_diversification",
        "identity",
        "temporal",
        "next_required_step_status"
      ],
      "properties": {
        "russian": {
          "enum": [
            "exhausted",
            "not_applicable"
          ]
        },
        "source_diversification": {
          "enum": [
            "exhausted",
            "not_applicable"
          ]
        },
        "identity": {
          "enum": [
            "exhausted",
            "not_applicable"
          ]
        },
        "temporal": {
          "enum": [
            "exhausted",
            "not_applicable"
          ]
        },
        "next_required_step_status": {
          "const": "none_all_required_routes_exhausted"
        }
      }
    }
  }
}
