{
  "contract": "FIXED-PACKAGE-PURCHASE-OPTION-V1",
  "version": "1.0",
  "status": "implementation_only",
  "purpose": "Recommend a fixed Steam Store Package as a purchase alternative when it is objectively cheaper than buying multiple currently visible base-game families separately, without changing Taste scope or ranking.",
  "authority": {
    "ownership_contract": "config/execution_ownership_contract.json",
    "offer_family_contract": "config/offer_family_contract.json",
    "github_owns_discovery_and_comparison": true,
    "ui_is_display_only": true,
    "taste_scope_must_not_change": true,
    "ranking_must_not_change": true
  },
  "discovery": {
    "network_source": "IStoreBrowseService/GetItems",
    "country_code": "KZ",
    "include_all_purchase_options": true,
    "supported_entity_kind": "Sub_",
    "fixed_price_semantics_required": true,
    "dynamic_bundle_ids_supported": false,
    "personalized_complete_the_set_supported": false,
    "missing_or_unreturned_optional_package_is_nonblocking": true
  },
  "comparison": {
    "minimum_visible_base_game_family_count": 2,
    "count_distinct_families_once": true,
    "require_strict_current_price_savings": true,
    "standalone_reference": "sum of current primary KZT prices for currently visible base-game families covered by the package",
    "unknown_extra_content_value_kzt": 0,
    "unknown_or_nonvisible_content_never_increases_computed_savings": true,
    "best_option_order": [
      "greater_absolute_savings_kzt",
      "lower_package_price_kzt",
      "lower_packageid"
    ],
    "advice_is_conditional_on_multi_game_intent": true
  },
  "output": {
    "pre_ai_artifact": "data/production/pre_ai/fixed_package_options.json",
    "visual_field": "better_purchase_option",
    "also_append_to_existing_offers": true,
    "ranking_review_includes_better_purchase_option": true
  },
  "regression": {
    "bioshock_package_key": "Sub_127633",
    "bioshock_standalone_current_kzt_fixture": 2034,
    "bioshock_package_current_kzt_fixture": 1420,
    "bioshock_expected_savings_kzt_fixture": 614,
    "test_script": "scripts/test_fixed_package_purchase_options.py"
  }
}
