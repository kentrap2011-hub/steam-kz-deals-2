{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "version": 2,
  "status": "active",
  "contract_revision": "story-dlc-scope-positive-evidence-2026-09-18",
  "purpose": "Prepare one complete fixed daily neutral Steam review dossier backlog snapshot before Taste semantic analysis, preserve checkpoint-sized durable progress inside that fixed snapshot, expose a bounded GitHub-derived compact read projection for the scheduled worker, and use buffered create-only group transport without transferring canonical progress or queue ownership away from GitHub.",
  "ownership": {
    "control_plane": "github",
    "semantic_data_plane": "scheduled_chatgpt_dossier_worker",
    "github_responsibilities": [
      "select_full_current_eligible_taste_backlog_dossier_scope_once_per_daily_pre_ai_preparation",
      "deduplicate_dossier_scope_by_appid_preserving_canonical_queue_order",
      "classify_addon_story_eligibility_from_github_accessible_steam_product_metadata_before_dossier_scope_projection",
      "decide_fresh_vs_stale_at_daily_preparation_time",
      "prepare_one_complete_fixed_daily_work_manifest",
      "prepare_internal_checkpoint_from_remaining_daily_snapshot_scope",
      "predeclare_immutable_ordered_group_plan_for_active_buffered_mode",
      "generate_validate_compact_worker_read_projection_from_canonical_manifest_and_group_plan",
      "synchronize_compact_worker_index_with_canonical_progress_without_mutating_same_snapshot_descriptors",
      "own_canonical_expected_group_sequence",
      "advance_same_snapshot_progress_only_after_successful_canonical_persistence",
      "track_same_snapshot_backlog_completeness_and_resume",
      "validate_submission",
      "validate_buffered_group_exactly_against_predeclared_group",
      "own_gap_retry_stale_replay_and_duplicate_interpretation",
      "persist_compact_dossier",
      "persist_canonical_manifest_progress",
      "cleanup_or_consume_buffer_artifacts",
      "serialize_all_github_writers_of_the_dossier_canonical_manifest",
      "cleanup_expired_out_of_scope_dossiers",
      "build_fail_closed_taste_semantic_input_from_active_pin"
    ],
    "semantic_worker_responsibilities": [
      "read_only_the_github_generated_compact_worker_index_and_exact_group_descriptors",
      "process_only_exact_group_descriptor_content_projected_by_github_from_the_immutable_canonical_plan",
      "perform_bounded_multi_source_player_feedback_web_research",
      "bind_observation_mention_counts_to_distinct_attributable_player_feedback_records",
      "perform_a_distinct_russian_player_feedback_attempt_without_treating_store_language_ui_as_feedback",
      "produce_neutral_compact_synthesis_with_provenance",
      "publish_each_completed_group_only_through_repository_defined_create_only_transport",
      "continue_from_group_n_to_the_immediately_next_projected_group_after_successful_create_only_publication_without_waiting_for_canonical_ingest"
    ],
    "forbidden": [
      "treat_all_dlc_or_addons_as_independent_taste_semantic_scope",
      "invent_scope",
      "refresh_or_rebuild_scope_on_manual_run_now",
      "refresh_or_rebuild_scope_after_checkpoint_persistence",
      "manage_queue_or_retry_policy",
      "interpret_buffer_as_canonical_progress_retry_state_or_chatgpt_queue",
      "skip_a_missing_or_invalid_predeclared_group",
      "choose_alternate_retry_filenames",
      "overwrite_update_or_delete_buffer_artifacts_from_chatgpt",
      "write_or_mutate_worker_index_or_group_descriptors_from_chatgpt",
      "reconstruct_missing_group_descriptors_from_partial_full_manifest_fields",
      "turn_checkpoint_size_into_run_or_daily_quota",
      "declare_ready_before_same_snapshot_remaining_scope_is_zero",
      "score_personal_fit",
      "choose_include_or_exclude",
      "use_price_discount_or_sale_urgency",
      "archive_raw_review_text",
      "change_taste_pin_or_taste_ingest_authority"
    ]
  },
  "daily_preparation": {
    "owner": "github_control_plane",
    "mode": "fixed_full_daily_snapshot",
    "workflow_name": "Build pre-AI deterministic payload",
    "workflow_file": ".github/workflows/build-pre-ai-store-snapshot.yml",
    "queue_build_step": "Build split ChatGPT consumer bundle",
    "manifest_build_position": "after_chatgpt_consumer_bundle_before_atomic_pre_ai_commit",
    "publication_rule": "publish_complete_manifest_and_compact_worker_projection_in_same_atomic_pre_ai_commit_before_scheduled_dossier_worker",
    "source_read_rule": "read_current_canonical_taste_queue_once_for_snapshot_preparation",
    "zero_work_rule": "publish_valid_complete_empty_snapshot_and_complete_worker_index",
    "next_refresh_rule": "queue_changes_after_snapshot_preparation_wait_until_next_daily_preparation"
  },
  "scope": {
    "source": "daily_fixed_snapshot_of_full_current_canonical_taste_queue",
    "source_path": "data/production/pre_ai/chatgpt_taste_queue.jsonl",
    "eligibility": "row_requires_at_least_one_canonical_taste_semantic_work_item_and_if_addon_has_positive_substantial_playable_story_evidence",
    "taste_semantic_work_required_any": [
      "evaluate_taste_fit",
      "evaluate_normalized_taste_factors",
      "resolve_grounded_negative_analysis"
    ],
    "base_support_only_behavior": "exclude_from_dossier_scope",
    "identity": "appid",
    "dedupe": "first_occurrence_by_appid_preserving_canonical_queue_order",
    "active_pin_role": "downstream_semantic_input_only_not_dossier_scope",
    "snapshot_membership_rule": "fixed_from_daily_preparation_until_next_daily_preparation",
    "manual_run_now_rule": "consume_latest_prepared_daily_snapshot_without_on_demand_scope_refresh",
    "story_dlc_policy": {
      "revision": "story-dlc-positive-evidence-v1",
      "applies_to": "canonical_taste_queue_rows_identified_as_addon_by_family_or_addon_semantic_condition",
      "base_game_behavior": "unchanged",
      "positive_evidence_source": "canonical_taste_queue.short_description_derived_from_steam_storebrowse_or_steam_appdetails_product_metadata",
      "positive_rule": "include_only_when_product_metadata_positively_confirms_substantial_playable_narrative_content_such_as_a_story_campaign_story_expansion_story_chapter_or_episode_story_questline_or_separate_playable_adventure",
      "title_rule": "title_may_support_negative_classification_but_must_not_be_the_only_positive_story_truth_source",
      "mixed_content_rule": "story_plus_cosmetics_or_bonus_content_is_eligible_only_when_the_story_component_is_independently_positive_and_substantial",
      "non_story_examples": [
        "digital_deluxe_or_deluxe_upgrade",
        "soundtrack_or_ost",
        "digital_artbook",
        "cosmetic_or_skin_pack",
        "weapon_item_equipment_pack",
        "currency_or_resource_pack",
        "bonus_songs",
        "wallpapers_or_avatars",
        "supporter_or_founder_pack_without_story"
      ],
      "container_rule": "season_pass_or_container_entitlement_is_not_itself_story_dlc_only_because_it_grants_story_dlc_children",
      "ambiguity_rule": "exclude_fail_closed_when_positive_story_content_cannot_be_proven_from_available_canonical_product_metadata",
      "machine_classifications": [
        "story_dlc_eligible",
        "non_story_dlc_excluded",
        "story_content_unproven_excluded"
      ]
    }
  },
  "manifest": {
    "preparation_mode": "daily_fixed_full_backlog",
    "identity": "snapshot_id",
    "immutable_snapshot_fields": [
      "snapshot_id",
      "prepared_at_utc",
      "prepared_for_date",
      "source_queue_path",
      "source_queue_sha256",
      "eligible_scope_count",
      "eligible_scope_sha256",
      "prepared_required_items",
      "prepared_required_count",
      "prepared_required_sha256",
      "story_dlc_scope_policy_revision",
      "story_dlc_scope_sha256",
      "story_dlc_scope"
    ],
    "mutable_progress_fields": [
      "remaining_required_items",
      "remaining_required_count",
      "completed_required_count",
      "current_checkpoint_items",
      "current_checkpoint_count",
      "full_backlog_complete",
      "status"
    ],
    "progress_rule": "accepted_checkpoint_removes_only_that_checkpoint_from_remaining_scope_without_re-reading_source_queue",
    "replacement_rule": "next_daily_preparation_replaces_previous_snapshot_with_new_current_queue_and_store_evaluation",
    "buffered_mode_extension": {
      "status": "active",
      "manifest_requirement": "github_publishes_an_immutable_group_plan_derived_only_from_prepared_required_items_for_buffered_worker_traversal",
      "group_plan_is_canonical_scope_projection": true,
      "group_plan_is_canonical_progress": false,
      "worker_read_surface": "github_derived_compact_index_plus_immutable_per_group_descriptors",
      "worker_read_surface_is_canonical_authority": false
    }
  },
  "checkpointing": {
    "owner": "github_control_plane",
    "checkpoint_size": 3,
    "semantics": "internal_durability_boundary_not_scope_quota",
    "completion_scope": "entire_same_prepared_daily_snapshot",
    "ordering": "prepared_snapshot_canonical_queue_order_after_appid_deduplication",
    "advance_rule": "after_successful_checkpoint_persistence_advance_progress_inside_same_snapshot_without_queue_or_store_scope_rebuild",
    "same_invocation_rule": "active_buffered_mode_may_traverse_only_the_next_predeclared_group_after_successful_create_only_publication_without_waiting_for_advanced_manifest;legacy_compatibility_fallback_waits_for_advanced_manifest",
    "resume_rule": "later_invocation_starts_from_github_owned_canonical_progress_for_the_same_latest_prepared_daily_snapshot",
    "ready_condition": "same_snapshot_remaining_required_count_zero",
    "failure_rule": "invalid_or_failed_later_checkpoint_does_not_discard_prior_durable_checkpoint_progress",
    "forbidden_interpretations": [
      "daily_cap",
      "run_quota",
      "production_limit",
      "overall_scope_limit",
      "completion_after_first_checkpoint",
      "checkpoint_triggered_scope_rebuild"
    ]
  },
  "buffered_submission": {
    "status": "active",
    "architecture": "immutable_predeclared_group_plan_plus_github_compact_read_projection_plus_create_only_transport_buffer_plus_github_contiguous_drain",
    "activation_gate": {
      "rule": "buffered_transport_and_compact_worker_read_projection_are_active_under_this_contract_and_the_landed_runtime",
      "runtime_requirements_met": [
        "manifest_group_plan_representation_and_schema_support",
        "github_generated_compact_worker_index_and_immutable_group_descriptors",
        "buffered_group_validation_and_state_based_contiguous_drain_runtime",
        "shared_serialized_canonical_writer_workflow_rule",
        "state_based_github_workflow_wake_up_handling",
        "worker_prompt_alignment_to_compact_buffered_mode",
        "contract_and_runtime_regression_validation",
        "director_authorized_live_prompt_installation"
      ],
      "post_alignment_acceptance": "separate_live_acceptance_may_reverify_observed_behavior_but_is_not_a_runtime_activation_gate"
    },
    "group_plan": {
      "owner": "github_control_plane",
      "source": "existing_fixed_prepared_required_items",
      "partition_rule": "contiguous_non_overlapping_chunks_in_prepared_required_items_order_using_checkpoint_size",
      "sequence_base": 1,
      "immutable_descriptor_required_fields": [
        "snapshot_id",
        "prepared_required_sha256",
        "sequence",
        "start_index",
        "end_index_exclusive",
        "items",
        "appids",
        "items_sha256",
        "group_sha256",
        "scope_source",
        "source_queue_sha256"
      ],
      "items_rule": "items_must_exactly_equal_prepared_required_items[start_index:end_index_exclusive]_in_order",
      "appids_rule": "appids_must_exactly_equal_the_ordered_appids_projected_from_items",
      "items_sha256_rule": "canonical_sha256_of_exact_ordered_group_items",
      "group_sha256_rule": "canonical_sha256_of_snapshot_id_prepared_required_sha256_sequence_start_index_end_index_exclusive_exact_ordered_appids_items_sha256_scope_source_source_queue_sha256",
      "identity_independence_rule": "group_identity_must_not_depend_on_mutable_remaining_required_items_or_current_scope_sha256",
      "immutability_rule": "the_group_plan_for_a_snapshot_cannot_change_when_canonical_progress_advances"
    },
    "worker": {
      "start_rule": "start_from_canonical_expected_sequence_in_the_github_generated_worker_index_then_read_only_that_exact_compact_group_descriptor",
      "same_invocation_progression_rule": "after_successful_create_only_publication_of_group_n_the_worker_may_process_only_group_n_plus_1_from_the_same_immutable_projected_plan_without_waiting_for_canonical_ingest",
      "same_invocation_progression_is_not_canonical_progress": true,
      "liveness_rule": "before_each_later_group_re_read_the_tiny_index_only_as_snapshot_plan_and_binding_guard_not_as_a_progress_gate",
      "deterministic_artifact_already_exists_rule": "if_the_deterministic_artifact_for_the_current_canonical_expected_group_already_exists_while_canonical_progress_has_not_advanced_do_not_overwrite_rename_skip_or_create_an_alternate_artifact;stop_and_leave_drain_retry_interpretation_to_github",
      "interrupted_invocation_rule": "on_a_later_invocation_reload_github_worker_index_and_start_from_its_canonical_expected_sequence;do_not_scan_pending_buffer_files_to_invent_resume_order_or_retry_state",
      "snapshot_replacement_rule": "if_a_different_current_snapshot_or_group_plan_is_observed_do_not_publish_more_groups_for_the_superseded_projection",
      "forbidden": [
        "derive_new_scope",
        "choose_arbitrary_group_offsets",
        "reconstruct_descriptor_from_partial_full_manifest_fields",
        "skip_gaps",
        "interpret_replay_or_stale_state",
        "manage_buffer_cleanup",
        "declare_completeness"
      ]
    },
    "buffer": {
      "role": "transport_only",
      "canonical_progress": false,
      "retry_state": false,
      "chatgpt_queue": false,
      "multiple_pending_groups_same_snapshot_allowed": true,
      "worker_write_mode": "immutable_create_only_one_artifact_per_group",
      "alternate_retry_filenames_allowed": false,
      "worker_overwrite_update_delete_allowed": false,
      "cleanup_owner": "github_control_plane"
    },
    "drain": {
      "status": "active",
      "owner": "github_control_plane",
      "wake_up_semantics": "a_buffer_push_is_only_a_wake_up_signal;current_repository_state_is_the_input",
      "state_source": "full_canonical_work_manifest_and_buffer_not_compact_worker_projection",
      "expected_sequence_source": "canonical_manifest_progress",
      "acceptance_rule": "accept_only_the_maximal_valid_contiguous_prefix_starting_at_expected_sequence",
      "gap_rule": "stop_at_the_first_missing_or_invalid_expected_group_and_never_advance_through_a_gap",
      "validation_rule": "each_group_must_exactly_match_its_predeclared_descriptor_from_the_full_canonical_manifest_snapshot_sequence_range_ordered_items_appids_hashes_and_provenance_bindings_and_each_dossier_must_pass_canonical_validation",
      "malformed_reordered_out_of_scope_rule": "the_first_such_expected_group_blocks_itself_and_every_later_group",
      "wrong_snapshot_rule": "never_apply_to_current_snapshot",
      "replay_rule": "a_group_already_canonically_accepted_must_not_persist_or_advance_again",
      "duplicate_rule": "deterministic_path_is_authoritative;alternate_filename_duplicates_are_invalid",
      "idempotency_rule": "reruns_derive_truth_again_from_current_github_canonical_state_and_replay_cannot_repeat_canonical_advancement",
      "cleanup_rule": "only_github_may_delete_consume_or_mark_buffer_artifacts",
      "example_contiguous": "expected=5;buffer=5,6,7,8=>accept=5,6,7,8",
      "example_gap": "expected=5;buffer=5,6,8=>accept=5,6;stop_at=7"
    },
    "canonical_writer_serialization": {
      "owner": "github_control_plane",
      "rule": "all_github_processes_that_can_mutate_the_dossier_canonical_manifest_or_its_compact_worker_projection_must_participate_in_one_serialized_canonical_writer_boundary",
      "includes_at_minimum": [
        "buffer_drain",
        "daily_pre_ai_snapshot_preparation"
      ],
      "workflow_implementation": "github_actions_concurrency_group_taste-steam-review-dossier-canonical-writer_cancel_in_progress_false"
    },
    "daily_rollover": {
      "rule": "artifacts_or_compact_descriptors_bound_to_an_old_snapshot_can_never_mutate_or_authorize_publication_for_a_new_current_snapshot",
      "stale_buffer_cleanup_owner": "github_control_plane",
      "worker_rule": "do_not_rebind_old_artifacts_or_descriptors_to_new_snapshot"
    },
    "active_snapshot_migration": {
      "status": "compatible_same_day_preservation_with_incompatible_contract_rebuild",
      "rebuild_scope": "required_when_evidence_binding_or_canonical_group_size_is_incompatible",
      "preserve_snapshot_id": "only_when_evidence_binding_and_group_size_are_compatible",
      "preserve_already_accepted_progress": "only_inside_the_same_compatible_snapshot",
      "plan_source": "existing_fixed_prepared_required_items_for_compatible_snapshots;normal_daily_builder_for_incompatible_rebuilds",
      "proof_requirements": [
        "prepared_required_sha256_matches_existing_prepared_required_items",
        "completed_required_count_equals_prepared_required_count_minus_remaining_required_count",
        "remaining_required_items_exactly_equal_prepared_required_items[completed_required_count:]",
        "completed_required_count_lands_on_a_group_boundary_unless_the_snapshot_is_fully_complete",
        "all_derived_group_descriptors_reproduce_the_existing_prepared_order_without_reordering_or_scope_change"
      ],
      "accepted_group_rule": "only_groups_under_the_same_compatible_worker_evidence_binding_and_group_plan_can_be_treated_as_already_canonically_accepted",
      "next_group_rule": "continue_from_the_first_group_after_the_proven_accepted_prefix_only_for_a_compatible_snapshot",
      "failure_rule": "an_incompatible_evidence_binding_or_group_size_must_rebuild_through_the_normal_github_owned_pre_ai_path_without_manual_progress_or_cache_rewrites"
    }
  },
  "worker_read_projection": {
    "status": "active",
    "owner": "github_control_plane",
    "canonical_authority": false,
    "canonical_source": "data/production/pre_ai/taste_steam_review_dossier_work.json",
    "index_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-INDEX-V1",
    "group_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-GROUP-V1",
    "descriptor_path_template": "data/production/pre_ai/taste_steam_review_dossier_worker_groups/{snapshot_id}/g{sequence:06d}.json",
    "index_rule": "contains_only_o1_snapshot_plan_progress_sampling_and_address_bindings_derived_from_the_full_canonical_manifest",
    "descriptor_rule": "one_file_per_exact_immutable_canonical_group_with_projection_level_plan_bindings_and_no_worker_recomputation_of_scope_or_identity",
    "same_snapshot_immutability_rule": "descriptor_files_must_remain_byte_identical_when_only_canonical_progress_advances",
    "progress_rule": "same_snapshot_progress_changes_update_only_the_mutable_worker_index_progress_fields",
    "daily_rollover_rule": "github_replaces_the_active_projection_with_the_new_snapshot_projection_and_removes_old_snapshot_directories_from_the_current_tree",
    "same_day_adoption_rule": "preserve_only_when_the_current_manifest_already_matches_the_active_evidence_binding_and_canonical_group_size;otherwise_rebuild_through_the_normal_github_owned_path",
    "worker_liveness_rule": "re_read_index_between_locally_sequential_groups_only_to_guard_snapshot_plan_and_bindings_not_to_wait_for_canonical_progress",
    "worker_fallback_rule": "no_full_manifest_or_partial_field_descriptor_reconstruction_fallback_is_allowed",
    "github_validation_rule": "generation_must_validate_the_complete_index_and_descriptor_set_against_the_full_canonical_manifest_before_commit"
  },
  "transition": {
    "reason": "evidence_guard_binds_recurring_claims_to_attributable_player_feedback_records_and_reduces_the_canonical_research_transport_boundary_to_three_games",
    "schema_version_rule": "retain_contract_v2_work_v2_and_dossier_v2_while_the_explicit_web_evidence_binding_moves_to_v2",
    "active_transport_mode": "buffered_group_create_only_v1",
    "active_worker_read_mode": "compact_worker_index_and_immutable_group_descriptors_v1",
    "compatibility_fallback_transport_mode": "current_checkpoint_create_only_v1",
    "legacy_current_checkpoint_role": "transitional_compatibility_fallback_only_not_authoritative_live_worker_transport",
    "current_worker_prompt": "config/taste_steam_review_dossier_worker_prompt.md_is_the_active_compact_buffered_worker_contract",
    "current_manifest_schema": "TASTE-STEAM-REVIEW-DOSSIER-WORK-V2_with_immutable_submission_group_plan_remains_current_runtime_authority",
    "runtime_change_required_for_current_activation": false
  },
  "freshness": {
    "default_ttl_days": 20,
    "min_ttl_days": 1,
    "max_ttl_days": 60,
    "fresh_behavior": "reuse_without_reanalysis_only_when_the_active_strict_web_evidence_binding_still_validates",
    "stale_behavior": "refresh_required_if_in_daily_prepared_dossier_scope",
    "missing_behavior": "create_required",
    "replacement_policy": "replace_current_dossier_no_unbounded_history"
  },
  "cleanup": {
    "owner": "github_control_plane",
    "scheduler": "none_created_by_this_task",
    "delete_rule": "stale_and_not_in_current_dossier_scope",
    "preserve_rules": [
      "fresh_regardless_of_scope_when_compatible_with_active_evidence_binding",
