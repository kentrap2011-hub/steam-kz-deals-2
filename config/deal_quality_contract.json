{
  "contract": "DEAL-QUALITY-AND-SORT-V1",
  "version": "1.1",
  "status": "implementation_only",
  "purpose": "Keep taste as the eligibility base, drop only commercially symbolic discounts before AI purchase ranking, and preserve all otherwise taste-eligible offers for final taste-plus-deal ordering.",
  "authority": {
    "canonical_policy_path": "config/mailing_policy.json",
    "never_overrides_canonical_policy": true,
    "taste_is_already_final": true,
    "deal_quality_never_raises_taste_fit": true,
    "weak_taste_can_never_be_rescued_by_discount": true,
    "price_alone_is_not_a_hard_exclusion_for_moderate_or_strong_taste": true
  },
  "commercial_visibility_gate": {
    "symbolic_discount_max_percent_inclusive": 5,
    "symbolic_discount_action": "exclude_before_final_purchase_ranking",
    "above_symbolic_discount_action": "keep_for_final_taste_plus_deal_ranking",
    "note": "The 5% value is the explicit conservative operationalization of the user's example of a discount that gives essentially nothing. No higher hidden hard discount threshold is invented."
  },
  "user_price_tolerance": {
    "reference_target_rub": 500,
    "target_is_not_hard_cap": true,
    "comparison_uses_unrounded_rub_value": true,
    "display_may_round_rub": true,
    "rule": "Price affects deal attractiveness and buy/wait judgment but does not remove a moderate- or strong-taste offer merely for being expensive."
  },
  "history_quality": {
    "confirmed_paid_minimum": {
      "record": "current_kzt <= historical_min_kzt",
      "near_record": "0 < (current_kzt / historical_min_kzt - 1) <= 0.10",
      "good_vs_history": "0.10 < (current_kzt / historical_min_kzt - 1) <= 0.25",
      "well_above_history": "(current_kzt / historical_min_kzt - 1) > 0.25"
    },
    "previously_free": "Use the distinct previously_free class; never compute a paid delta from zero.",
    "unavailable_exact_history": "Use unverified; do not invent or currency-convert a historical minimum.",
    "threshold_boundaries_are_inclusive_on_the_lower_price_class": true
  },
  "purchase_decision": {
    "record": "БРАТЬ СЕЙЧАС",
    "near_record": "БРАТЬ СЕЙЧАС",
    "good_vs_history": "МОЖНО БРАТЬ",
    "previously_free": "МОЖНО БРАТЬ",
    "unverified": "МОЖНО БРАТЬ",
    "well_above_history": "ЛУЧШЕ ЖДАТЬ",
    "note": "These labels describe deal timing only. They never change taste fit and are not a hard price gate."
  },
  "deal_features_for_final_ranking": [
    "discount_percent",
    "current_price_rub_unrounded",
    "history_quality",
    "delta_vs_paid_historical_minimum",
    "previously_free",
    "sale_end_if_known"
  ],
  "final_ranking_principles": {
    "taste_is_primary": true,
    "conceptual_weight_taste": 0.6,
    "conceptual_weight_deal": 0.4,
    "do_not_invent_numeric_taste_score_from_strong_or_moderate_without_an_explicit_contract": true,
    "strong_discount_cannot_promote_below_moderate_taste": true,
    "moderate_or_strong_taste_with_weak_but_non_symbolic_deal_may_remain_as_wait_or_low_priority": true,
    "visual_presentation_and_final_display_shape_are_deferred": true
  },
  "fx": {
    "base": "RUB",
    "quote": "KZT",
    "source_url": "https://open.er-api.com/v6/latest/RUB",
    "max_rate_age_hours": 48,
    "one_request_per_stage_run": true,
    "fail_closed_if_rate_unavailable_or_stale": true,
    "rub_value_formula": "kzt / kzt_per_rub"
  },
  "sorting": {
    "current_data_preparation_only": true,
    "preserve_fields_for_later_final_ranking": true,
    "do_not_treat_purchase_decision_as_stronger_than_taste": true,
    "stable_fallback_keys": [
      "taste_fit desc",
      "purchase_decision quality desc",
      "history_quality desc",
      "discount_percent desc",
      "current_price_rub_unrounded asc",
      "title casefold asc",
      "primary_key asc"
    ],
    "note": "The final visual ordering will be redesigned later. This contract only guarantees that no non-symbolic moderate/strong offer is lost before that stage."
  }
}
