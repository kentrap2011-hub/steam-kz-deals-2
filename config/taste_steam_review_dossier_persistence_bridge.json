{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-PERSISTENCE-BRIDGE-V1",
  "version": 1,
  "status": "active",
  "contract_revision": "buffered-submission-contract-2026-09-14",
  "parent_contract": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "ownership": {
    "submission_producer": "scheduled_chatgpt_dossier_worker",
    "submission_transport": "connected_github_contents_create_file",
    "validation_persistence_progress_completeness": "github_actions_control_plane",
    "direct_semantic_worker_canonical_state_write": false,
    "buffer_cleanup": "github_actions_control_plane",
    "gap_retry_stale_replay_interpretation": "github_actions_control_plane"
  },
  "transition": {
    "rule": "contract_first_change_is_additive_and_must_not_activate_unimplemented_buffered_runtime",
    "active_transport_mode": "current_checkpoint_create_only_v1",
    "authorized_future_transport_mode": "buffered_group_create_only_v1",
    "buffered_transport_status": "authorized_not_activated",
    "legacy_current_checkpoint_path_remains_valid": true,
    "activation_requires": [
      "github_published_immutable_group_plan",
      "buffered_group_validator_and_state_based_contiguous_drain",
      "shared_serialized_dossier_manifest_writer_boundary",
      "worker_prompt_alignment",
      "contract_runtime_regression_validation",
      "director_acceptance"
    ]
  },
  "submission": {
    "repository": "kentrap2011-hub/steam-kz-deals-2",
    "branch": "main",
    "action": "github_contents_create_file",
    "mode": "create_only",
    "runtime_status": "active_transition_legacy_path",
    "schema": "TASTE-STEAM-REVIEW-DOSSIER-SUBMISSION-V1",
    "path_template": "data/ai_inbox/taste_steam_review_dossiers/{snapshot_id}--{scope_sha256}.json",
    "required_bindings": [
      "snapshot_id",
      "scope_sha256",
      "scope_source",
      "source_queue_sha256",
      "exact_current_checkpoint_appids_in_order"
    ],
    "existing_path_rule": "reload_canonical_manifest_never_overwrite_or_choose_alternate_filename"
  },
  "buffered_transport": {
    "status": "authorized_not_activated",
    "future_schema": "TASTE-STEAM-REVIEW-DOSSIER-BUFFERED-GROUP-V1",
    "repository": "kentrap2011-hub/steam-kz-deals-2",
    "branch": "main",
    "action": "github_contents_create_file",
    "mode": "immutable_create_only_one_file_per_predeclared_group",
    "path_template": "data/ai_inbox/taste_steam_review_dossiers/{snapshot_id}--g{sequence:06d}--{group_sha256}.json",
    "multiple_pending_groups_same_snapshot_allowed": true,
    "alternate_retry_filenames_allowed": false,
    "worker_overwrite_update_delete_allowed": false,
    "required_group_bindings": [
      "snapshot_id",
      "prepared_required_sha256",
      "sequence",
      "start_index",
      "end_index_exclusive",
      "exact_ordered_items",
      "exact_ordered_appids",
      "items_sha256",
      "group_sha256",
      "scope_source",
      "source_queue_sha256"
    ],
    "group_identity_rule": "must_exactly_match_the_immutable_github_predeclared_group_descriptor_and_must_not_depend_on_mutable_scope_sha256",
    "successful_create_rule": "within_the_same_invocation_the_worker_may_continue_only_to_the_immediately_next_predeclared_group_without_waiting_for_canonical_ingest",
    "existing_expected_artifact_rule": "if_the_deterministic_artifact_for_the_current_canonical_expected_group_already_exists_and_canonical_progress_has_not_advanced_stop_without_overwrite_rename_skip_or_alternate_filename",
    "interrupted_invocation_rule": "next_invocation_reloads_github_canonical_expected_group_and_does_not_scan_buffer_to_invent_resume_or_retry_state",
    "buffer_semantics": {
      "transport_only": true,
      "canonical_progress": false,
      "retry_state": false,
      "chatgpt_queue": false,
      "completeness_authority": false
    }
  },
  "ingest": {
    "trigger": "github_push_from_create_file_artifact",
    "workflow": ".github/workflows/ingest-taste-steam-review-dossier-checkpoint.yml",
    "adapter": "scripts/ingest_taste_steam_review_dossier_inbox.py",
    "canonical_ingest": "scripts/ingest_taste_steam_review_dossiers.py",
    "same_snapshot_only": true,
    "source_queue_reread": false,
    "accepted_submission_cleanup": "delete_inbox_artifact_in_same_canonical_commit",
    "atomic_git_commit_paths": [
      "data/cache/taste_steam_review_dossiers/**",
      "data/production/pre_ai/taste_steam_review_dossier_work.json",
      "data/ai_inbox/taste_steam_review_dossiers/**"
    ],
    "runtime_status": "legacy_single_current_checkpoint_ingest_remains_active_until_buffered_implementation"
  },
  "future_buffered_drain": {
    "status": "authorized_not_implemented",
    "owner": "github_actions_control_plane",
    "trigger_semantics": "buffer_push_is_only_a_wake_up_signal_not_the_queue_record",
    "state_source": "current_repository_canonical_manifest_group_plan_and_buffer",
    "expected_sequence_source": "github_owned_canonical_progress",
    "acceptance_rule": "validate_and_accept_only_the_maximal_valid_contiguous_prefix_starting_at_expected_sequence",
    "gap_rule": "never_skip_a_missing_or_invalid_expected_group",
    "exact_validation_required": [
      "snapshot_id",
      "prepared_required_sha256",
      "sequence",
      "start_index",
      "end_index_exclusive",
      "exact_ordered_items",
      "exact_ordered_appids",
      "items_sha256",
      "group_sha256",
      "scope_source",
      "source_queue_sha256",
      "each_dossier_against_canonical_dossier_contract"
    ],
    "blocking_expected_group_classes": [
      "malformed",
      "stale_or_masquerading_wrong_snapshot",
      "reordered",
      "out_of_scope",
      "wrong_group_identity",
      "invalid_dossier"
    ],
    "unrelated_old_snapshot_artifacts_rule": "cannot_mutate_or_advance_the_current_snapshot_and_are_left_for_github_owned_stale_cleanup",
    "replay_rule": "sequence_already_canonically_accepted_never_repersists_dossiers_or_advances_manifest_again",
    "duplicate_rule": "deterministic_path_is_authoritative_and_alternate_filename_duplicates_are_invalid",
    "idempotency_rule": "every_rerun_rederives_expected_sequence_and_buffer_truth_from_github_canonical_state",
    "cleanup_rule": "only_github_may_delete_consume_or_mark_buffer_artifacts",
    "example_contiguous": "expected=5;buffer=5,6,7,8=>accept=5,6,7,8",
    "example_gap": "expected=5;buffer=5,6,8=>accept=5,6;stop_at=7"
  },
  "canonical_writer": {
    "rule": "all_github_processes_that_can_mutate_the_dossier_canonical_manifest_must_share_one_serialized_canonical_writer_boundary",
    "includes_at_minimum": [
      "future_buffered_drain",
      "daily_pre_ai_snapshot_preparation"
    ],
    "buffer_push_role": "wake_up_signal_only",
    "workflow_mechanism": "deferred_to_future_buffered_submission_implement_task"
  },
  "daily_rollover": {
    "old_snapshot_buffer_may_mutate_new_snapshot": false,
    "validation_rule": "current_snapshot_binding_is_mandatory_before_any_canonical_persistence",
    "cleanup_owner": "github_actions_control_plane"
  },
  "failure": {
    "partial_or_mismatched_submission": "fail_closed_no_canonical_commit",
    "stale_or_replayed_submission": "fail_closed_against_current_manifest_binding_in_legacy_mode;buffered_mode_replay_is_idempotent_no_advance_and_stale_never_mutates_current_snapshot",
    "concurrent_canonical_change": "rebase_conflict_or_push_failure_fails_closed",
    "retry_loop_created": false
  },
  "forbidden": [
    "workflow_dispatch_as_required_worker_transport",
    "shell_execution_by_scheduled_chatgpt",
    "direct_chatgpt_write_to_dossier_store",
    "direct_chatgpt_write_to_work_manifest",
    "chatgpt_buffer_cleanup",
    "chatgpt_gap_retry_or_replay_interpretation",
    "alternate_retry_filename",
    "mutable_shared_buffer_file",
    "second_dossier_scheduler",
    "independent_dossier_queue",
    "checkpoint_as_quota",
    "taste_semantic_producer_changes"
  ]
}
