{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROGRESSIVE-PASS2-RESULT-V1",
  "title": "Progressive PASS 2 exact-bound semantic result",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "run_start_anchor_commit",
    "run_start_authority_commit",
    "run_started_at_utc",
    "semantic_generation_id",
    "profile_pin_sha256",
    "work_id",
    "family_id",
    "taste_subject_key",
    "appid",
    "taste_fingerprint",
    "candidate_context_sha256",
    "dossier_content_sha256",
    "dossier_compatibility_binding",
    "authorization_id",
    "work_mode",
    "recovery_authorization_id",
    "recovery_reason",
    "recovery_condition_binding",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "PROGRESSIVE-PASS2-RESULT-V1"
    },
    "semantic_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "taste_subject_key": {
      "type": "string",
      "minLength": 1
    },
    "appid": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "taste_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "candidate_context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "dossier_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dossier_compatibility_binding": {
      "type": "object"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "analyzed_fit",
        "analyzed_not_fit",
        "analysis_incomplete"
      ]
    },
    "fit_level": {
      "enum": [
        "strong",
        "moderate"
      ]
    },
    "confidence": {
      "enum": [
        "medium",
        "high"
      ]
    },
    "positive_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taste_factors": {
      "type": "object"
    },
    "base_support_compatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "not_fit_basis": {
      "enum": [
        "completed_below_threshold",
        "confirmed_personal_negative"
      ]
    },
    "not_fit_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_code": {
      "enum": [
        "insufficient_evidence",
        "evidence_unavailable",
        "worker_failure",
        "base_support_unresolved",
        "terminal_execution_failure"
      ]
    },
    "work_mode": {
      "enum": [
        "normal_first_pass",
        "recovery"
      ]
    },
    "recovery_authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_reason": {
      "enum": [
        "materially_changed_canonically_accepted_dossier_or_evidence",
        "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
        "explicit_canonical_github_recovery_action_with_recorded_reason",
        null
      ]
    },
    "recovery_condition_binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "profile_pin_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_start_authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_start_anchor_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "negative_assessment": {
      "$ref": "#/$defs/deepNegativeAssessment"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "normal_first_pass"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "recovery"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_reason": {
            "enum": [
              "materially_changed_canonically_accepted_dossier_or_evidence",
              "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
              "explicit_canonical_github_recovery_action_with_recorded_reason"
            ]
          },
          "recovery_condition_binding": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "analyzed_fit",
              "analyzed_not_fit"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "negative_assessment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "analysis_incomplete"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "negative_assessment"
          ]
        }
      }
    }
  ],
  "$defs": {
    "deepNegativeEvidenceRef": {
      "type": "object",
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "conflict"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "deepNegativeFinding": {
      "type": "object",
      "required": [
        "disposition",
        "risk_code",
        "text_ru",
        "evidence_refs"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "confirmed_personal_risk",
            "caution"
          ]
        },
        "risk_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unchanged_repetition",
            "low_active_gameplay",
            "directionlessness",
            "management_routine",
            "difficulty_punishment",
            "stealth_restart_pressure",
            "felt_technical_burden",
            "other_grounded_taste_risk",
            null
          ]
        },
        "text_ru": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeEvidenceRef"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "confirmed_personal_risk"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "risk_code": {
                "type": "string",
                "enum": [
                  "unchanged_repetition",
                  "low_active_gameplay",
                  "directionlessness",
                  "management_routine",
                  "difficulty_punishment",
                  "stealth_restart_pressure",
                  "felt_technical_burden",
                  "other_grounded_taste_risk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "caution"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "risk_code": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "deepNegativeAssessment": {
      "type": "object",
      "required": [
        "status",
        "evaluated_candidate_refs",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "unresolved"
          ]
        },
        "evaluated_candidate_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeEvidenceRef"
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeFinding"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evaluated_candidate_refs": {
                "minItems": 1
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
