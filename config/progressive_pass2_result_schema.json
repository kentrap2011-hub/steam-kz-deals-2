{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROGRESSIVE-PASS2-RESULT-V1",
  "title": "Progressive PASS 2 exact-bound semantic result",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "semantic_generation_id",
    "work_id",
    "family_id",
    "taste_subject_key",
    "appid",
    "taste_fingerprint",
    "candidate_context_sha256",
    "dossier_content_sha256",
    "dossier_compatibility_binding",
    "authorization_id",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "PROGRESSIVE-PASS2-RESULT-V1"},
    "semantic_generation_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "taste_subject_key": {"type": "string", "minLength": 1},
    "appid": {"type": "string", "pattern": "^[0-9]+$"},
    "taste_fingerprint": {"type": "string", "minLength": 1},
    "candidate_context_sha256": {"type": "string", "minLength": 1},
    "dossier_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dossier_compatibility_binding": {"type": "object"},
    "authorization_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["analyzed_fit", "analyzed_not_fit", "analysis_incomplete"]},
    "fit_level": {"enum": ["strong", "moderate"]},
    "confidence": {"enum": ["medium", "high"]},
    "positive_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "taste_factors": {"type": "object"},
    "base_support_compatible": {"type": ["boolean", "null"]},
    "not_fit_basis": {"enum": ["completed_below_threshold", "confirmed_personal_negative"]},
    "not_fit_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "issue_code": {
      "enum": [
        "insufficient_evidence",
        "evidence_unavailable",
        "worker_failure",
        "base_support_unresolved",
        "terminal_execution_failure"
      ]
    }
  },
  "additionalProperties": false
}
