{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROGRESSIVE-PASS2-RESULT-V1",
  "title": "Progressive PASS 2 exact-bound semantic result",
  "type": "object",
  "required": [
    "schema_version",
    "contract",
    "run_start_anchor_commit",
    "run_start_authority_commit",
    "run_started_at_utc",
    "semantic_generation_id",
    "profile_pin_sha256",
    "work_id",
    "family_id",
    "taste_subject_key",
    "appid",
    "taste_fingerprint",
    "candidate_context_sha256",
    "dossier_content_sha256",
    "dossier_compatibility_binding",
    "authorization_id",
    "work_mode",
    "recovery_authorization_id",
    "recovery_reason",
    "recovery_condition_binding",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "PROGRESSIVE-PASS2-RESULT-V1"
    },
    "semantic_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "taste_subject_key": {
      "type": "string",
      "minLength": 1
    },
    "appid": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "taste_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "candidate_context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "dossier_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dossier_compatibility_binding": {
      "type": "object"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "analyzed_fit",
        "analyzed_not_fit",
        "analysis_incomplete"
      ]
    },
    "fit_level": {
      "enum": [
        "strong",
        "moderate"
      ]
    },
    "confidence": {
      "enum": [
        "medium",
        "high"
      ]
    },
    "positive_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taste_factors": {
      "type": "object"
    },
    "base_support_compatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "not_fit_basis": {
      "enum": [
        "completed_below_threshold",
        "confirmed_personal_negative"
      ]
    },
    "not_fit_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_code": {
      "enum": [
        "insufficient_evidence",
        "evidence_unavailable",
        "worker_failure",
        "base_support_unresolved",
        "terminal_execution_failure"
      ]
    },
    "work_mode": {
      "enum": [
        "normal_first_pass",
        "recovery",
        "legacy_full_reanalysis",
        "score_explainability_migration"
      ]
    },
    "recovery_authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_reason": {
      "enum": [
        "materially_changed_canonically_accepted_dossier_or_evidence",
        "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
        "explicit_canonical_github_recovery_action_with_recorded_reason",
        null
      ]
    },
    "recovery_condition_binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "profile_pin_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_start_authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_start_anchor_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "negative_assessment": {
      "$ref": "#/$defs/deepNegativeAssessment"
    },
    "migration_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "migration_target_id",
        "migration_authority_commit",
        "migration_frozen_at_utc",
        "prior_outcome",
        "prior_fit_level",
        "prior_confidence",
        "prior_taste_factors",
        "prior_not_fit_basis",
        "prior_work_id",
        "prior_authorization_id",
        "prior_accepted_at_utc",
        "preserved_positive_evidence",
        "preserved_not_fit_evidence"
      ],
      "properties": {
        "migration_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_target_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_authority_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migration_frozen_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_outcome": {
          "enum": [
            "analyzed_fit",
            "analyzed_not_fit"
          ]
        },
        "prior_fit_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strong",
            "moderate",
            null
          ]
        },
        "prior_confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "medium",
            "high",
            null
          ]
        },
        "prior_taste_factors": {
          "type": [
            "object",
            "null"
          ]
        },
        "prior_not_fit_basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "completed_below_threshold",
            "confirmed_personal_negative",
            null
          ]
        },
        "prior_work_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_authorization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "preserved_positive_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserved_not_fit_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "score_evidence_contract": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "contract",
            "required"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "contract": {
              "const": "DEEP-SCORE-EVIDENCE-V1"
            },
            "required": {
              "const": true
            }
          }
        }
      ]
    },
    "score_findings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deepScoreFinding"
      }
    },
    "score_migration_provenance": {
      "$ref": "#/$defs/deepScoreMigrationProvenance"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "normal_first_pass"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "recovery"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "properties": {
          "recovery_authorization_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_reason": {
            "enum": [
              "materially_changed_canonically_accepted_dossier_or_evidence",
              "corrected_runtime_or_validation_defect_material_to_the_prior_failure",
              "explicit_canonical_github_recovery_action_with_recorded_reason"
            ]
          },
          "recovery_condition_binding": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "analyzed_fit",
              "analyzed_not_fit"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "negative_assessment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "analysis_incomplete"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "negative_assessment"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "legacy_full_reanalysis"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "required": [
          "migration_provenance"
        ],
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "normal_first_pass"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "migration_provenance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "recovery"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "migration_provenance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "analyzed_fit"
          },
          "score_evidence_contract": {
            "type": "object",
            "properties": {
              "contract": {
                "const": "DEEP-SCORE-EVIDENCE-V1"
              },
              "required": {
                "const": true
              }
            },
            "required": [
              "contract",
              "required"
            ]
          }
        },
        "required": [
          "outcome",
          "score_evidence_contract"
        ]
      },
      "then": {
        "required": [
          "score_findings"
        ]
      }
    },
    {
      "if": {
        "required": [
          "score_findings"
        ]
      },
      "then": {
        "required": [
          "score_evidence_contract"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "work_mode": {
            "const": "score_explainability_migration"
          }
        },
        "required": [
          "work_mode"
        ]
      },
      "then": {
        "required": [
          "score_migration_provenance",
          "score_evidence_contract"
        ],
        "not": {
          "required": [
            "migration_provenance"
          ]
        },
        "properties": {
          "recovery_authorization_id": {
            "type": "null"
          },
          "recovery_reason": {
            "type": "null"
          },
          "recovery_condition_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "analyzed_not_fit"
          },
          "not_fit_basis": {
            "const": "confirmed_personal_negative"
          }
        },
        "required": [
          "outcome",
          "not_fit_basis"
        ]
      },
      "then": {
        "required": [
          "confidence"
        ],
        "properties": {
          "confidence": {
            "const": "high"
          }
        }
      }
    }
  ],
  "$defs": {
    "deepNegativeEvidenceRef": {
      "type": "object",
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "conflict"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "deepNegativeFinding": {
      "type": "object",
      "required": [
        "disposition",
        "risk_code",
        "text_ru",
        "evidence_refs"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "confirmed_personal_risk",
            "caution"
          ]
        },
        "risk_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unchanged_repetition",
            "low_active_gameplay",
            "directionlessness",
            "management_routine",
            "difficulty_punishment",
            "stealth_restart_pressure",
            "felt_technical_burden",
            "other_grounded_taste_risk",
            null
          ]
        },
        "text_ru": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeEvidenceRef"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "confirmed_personal_risk"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "risk_code": {
                "type": "string",
                "enum": [
                  "unchanged_repetition",
                  "low_active_gameplay",
                  "directionlessness",
                  "management_routine",
                  "difficulty_punishment",
                  "stealth_restart_pressure",
                  "felt_technical_burden",
                  "other_grounded_taste_risk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "caution"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "risk_code": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "deepNegativeAssessment": {
      "type": "object",
      "required": [
        "status",
        "evaluated_candidate_refs",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "unresolved"
          ]
        },
        "evaluated_candidate_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeEvidenceRef"
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeFinding"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evaluated_candidate_refs": {
                "minItems": 1
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "deepProfileEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_pointer",
        "profile_value_sha256",
        "match_text_ru"
      ],
      "properties": {
        "json_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "profile_value_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "match_text_ru": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deepScoreFactorImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "effect",
        "normalized_value"
      ],
      "properties": {
        "factor_id": {
          "enum": [
            "gameplay_mastery",
            "development_variety",
            "structure_pacing_direction",
            "identity_hooks",
            "breadth_of_match"
          ]
        },
        "effect": {
          "enum": [
            "supports",
            "lowers",
            "qualifies"
          ]
        },
        "normalized_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "deepScoreFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "text_ru",
        "candidate_evidence_refs",
        "profile_evidence_refs",
        "factor_impacts"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "text_ru": {
          "type": "string",
          "minLength": 1
        },
        "candidate_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepNegativeEvidenceRef"
          }
        },
        "profile_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepProfileEvidenceRef"
          }
        },
        "factor_impacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deepScoreFactorImpact"
          }
        }
      }
    },
    "deepScoreMigrationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "migration_target_id",
        "migration_authority_commit",
        "migration_frozen_at_utc",
        "prior_authorization_id",
        "prior_accepted_at_utc",
        "prior_outcome",
        "prior_fit_level",
        "prior_confidence",
        "prior_taste_factors",
        "prior_positive_evidence",
        "prior_work_id"
      ],
      "properties": {
        "migration_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_target_id": {
          "type": "string",
          "minLength": 1
        },
        "migration_authority_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migration_frozen_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_authorization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prior_accepted_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "prior_outcome": {
          "const": "analyzed_fit"
        },
        "prior_fit_level": {
          "enum": [
            "strong",
            "moderate"
          ]
        },
        "prior_confidence": {
          "enum": [
            "medium",
            "high"
          ]
        },
        "prior_taste_factors": {
          "type": "object"
        },
        "prior_positive_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prior_work_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
