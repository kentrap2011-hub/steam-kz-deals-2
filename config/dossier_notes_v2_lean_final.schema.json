{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOSSIER-NOTES-V2-LEAN-FINAL-V1 (isolated trial only)",
  "description": "Compact neutral player-experience claims for the authorized inactive Notes V2 sandbox. Not the canonical V2 web-evidence schema, not Deep-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "appid",
    "title",
    "generated_at_utc",
    "expires_at_utc",
    "ttl_days",
    "game_identity",
    "summary",
    "observations",
    "conflicts",
    "sources",
    "unknowns",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "DOSSIER-NOTES-V2-LEAN-FINAL-V1"
    },
    "schema_version": {
      "const": 1
    },
    "appid": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "game_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appid",
        "work_title",
        "release_year"
      ],
      "properties": {
        "appid": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "work_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "release_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1970,
          "maximum": 2100
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "statement",
          "sentiment",
          "evidence_status",
          "as_of",
          "source_indices"
        ],
        "properties": {
          "category": {
            "enum": [
              "mechanics",
              "structure",
              "pacing",
              "progression",
              "repetition",
              "difficulty",
              "friction",
              "multiplayer",
              "coop",
              "localization",
              "translation",
              "voice",
              "font",
              "encoding",
              "regional",
              "other"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 24,
            "maxLength": 520
          },
          "sentiment": {
            "enum": [
              "positive",
              "negative",
              "mixed",
              "neutral"
            ]
          },
          "evidence_status": {
            "enum": [
              "durable",
              "uncertain",
              "current",
              "historical"
            ]
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "source_indices": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "source_indices"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 15,
            "maxLength": 520
          },
          "source_indices": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 600
          },
          "kind": {
            "enum": [
              "identity",
              "player_feedback",
              "context"
            ]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 350
      }
    },
    "confidence": {
      "enum": [
        "limited",
        "moderate"
      ]
    }
  }
}
