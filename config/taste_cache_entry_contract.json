{
  "contract": "TASTE-CACHE-ENTRY-BINDING-V5",
  "version": "1.0",
  "status": "canonical",
  "purpose": "Preserve exact reusable price-blind fit bindings while adding an independently bound V5 evidence-state layer. Legacy V2/V3/V4 fit entries remain reusable; ambiguous evidence semantics are backfilled through the existing Taste work path.",
  "authority": {
    "canonical_policy_path": "config/mailing_policy.json",
    "canonical_cache_path": "data/cache/taste_fit.json",
    "canonical_profile_repository": "kentrap2011-hub/stopgame-ratings-data",
    "canonical_profile_path": "gaming_taste_live.json",
    "semantic_result_contract": "config/taste_result_contract.json",
    "cache_is_derived_verdicts_only_not_user_evidence": true
  },
  "taste_semantics_policy_fields": [
    "taste_profile",
    "taste_deal_separation",
    "personal_filter",
    "false_negative_audit",
    "taste_factor_semantics"
  ],
  "taste_semantics_digest": {
    "algorithm": "sha256",
    "serialization": "json ensure_ascii=false sort_keys=true separators comma_colon",
    "purpose": "Invalidate cached decisions when actual taste-evaluation semantics change while ignoring unrelated render/cache plumbing changes.",
    "migration_note": "Evidence-state/confidence and grounded-negative V5 provenance are deliberately orthogonal to the existing fit semantic digest. Changing the evidence contract does not invalidate an otherwise exact fit cache entry; evidence readiness is bound separately."
  },
  "base_required_entry_fields": [
    "key",
    "appid",
    "profile_blob_sha",
    "taste_model_version",
    "taste_semantics_sha256",
    "taste_fingerprint",
    "verdict",
    "fit_level",
    "reason_code",
    "positive_evidence",
    "negative_evidence",
    "evaluated_at_utc"
  ],
  "schema_v2_required_entry_fields": [
    "key",
    "appid",
    "profile_blob_sha",
    "taste_model_version",
    "taste_semantics_sha256",
    "taste_fingerprint",
    "verdict",
    "fit_level",
    "reason_code",
    "positive_evidence",
    "negative_evidence",
    "evaluated_at_utc"
  ],
  "schema_v3_required_entry_fields": [
    "key",
    "appid",
    "profile_blob_sha",
    "taste_model_version",
    "taste_semantics_sha256",
    "taste_fingerprint",
    "verdict",
    "fit_level",
    "reason_code",
    "positive_evidence",
    "negative_evidence",
    "taste_factors",
    "evaluated_at_utc"
  ],
  "schema_v4_required_entry_fields": [
    "key",
    "appid",
    "profile_blob_sha",
    "taste_model_version",
    "taste_semantics_sha256",
    "candidate_context_sha256",
    "taste_fingerprint",
    "verdict",
    "fit_level",
    "reason_code",
    "positive_evidence",
    "negative_analysis_status",
    "negative_findings",
    "negative_evidence",
    "taste_factors",
    "evaluated_at_utc"
  ],
  "taste_factors": {
    "required_for_v3_and_v4_full_semantic_results": true,
    "exact_keys": [
      "gameplay_mastery",
      "development_variety",
      "structure_pacing_direction",
      "identity_hooks",
      "breadth_of_match"
    ],
    "value_range_inclusive": [
      0,
      100
    ],
    "weight_independent": true,
    "price_blind": true
  },
  "negative_analysis": {
    "status_values": [
      "complete_with_confirmed_negative",
      "incomplete_no_confirmed_negative"
    ],
    "legacy_entries_without_status_are_negative_ready": false,
    "legacy_negative_evidence_does_not_imply_readiness": true,
    "negative_only_backfill_preserves_fit_semantics": true,
    "compatibility_negative_evidence_is_ordered_finding_projection": true
  },
  "cache_hit_requires_same_entry": [
    "exact_key",
    "exact_appid",
    "exact_profile_blob_sha",
    "exact_taste_model_version",
    "exact_taste_semantics_sha256",
    "exact_taste_fingerprint"
  ],
  "mixed_generation_rules": {
    "different_profile_model_or_semantics_generations_may_coexist_in_one_canonical_cache": true,
    "legacy_v2_entries_without_taste_factors_may_be_read_during_migration": true,
    "legacy_v2_entries_without_taste_factors_are_not_v3_migration_complete": true,
    "legacy_v2_v3_entries_without_negative_status_may_be_fit_cache_hits": true,
    "legacy_v2_v3_entries_without_negative_status_are_not_negative_analysis_ready": true,
    "old_generation_entries_are_preserved_but_are_not_cache_hits_for_a_new_binding": true,
    "new_validated_batches_replace_only_their_exact_keys": true,
    "partial_refresh_becomes_reusable_immediately": true,
    "never_upgrade_an_old_entry_fit_binding_or_add_factors_without_a_new_ai_verdict": true,
    "negative_only_backfill_may_add_only_negative_analysis_fields_to_an_existing_valid_entry": true,
    "legacy_v4_entries_without_evidence_state_may_be_fit_cache_hits": true,
    "legacy_v4_entries_without_evidence_state_are_not_v5_evidence_bound": true,
    "v5_evidence_backfill_may_modify_only_evidence_and_negative_analysis_fields": true
  },
  "overlay": {
    "container_schema_version": 1,
    "current_entry_schema_version": 5,
    "mixed_v2_v3_v4_rows_allowed_during_migration": true,
    "mixed_v2_v3_v4_v5_rows_allowed_during_migration": true
  },
  "legacy_schema_v1_migration": {
    "allowed": true,
    "legacy_profile_binding_source": "taste_fit.json top-level profile_blob_sha",
    "legacy_model_binding_source": "taste_fit.json top-level taste_model_version",
    "legacy_semantics_binding_source": "data/cache/taste_fit.ledger_validation.json bindings.policy_blob_sha",
    "historical_policy_must_be_readable_from_git_object_database": true,
    "fail_closed_if_historical_policy_or_binding_cannot_be_proven": true
  },
  "schema_v5_required_entry_fields": [
    "key",
    "appid",
    "profile_blob_sha",
    "taste_model_version",
    "taste_semantics_sha256",
    "candidate_context_sha256",
    "taste_fingerprint",
    "verdict",
    "fit_level",
    "reason_code",
    "positive_evidence",
    "negative_analysis_status",
    "negative_findings",
    "negative_evidence",
    "taste_factors",
    "evidence_contract_sha",
    "fit_evidence_state",
    "fit_evidence_confidence",
    "fit_evidence_basis",
    "historical_negative_context",
    "candidate_quality_findings",
    "evaluated_at_utc"
  ],
  "evidence_state": {
    "contract_binding_field": "evidence_contract_sha",
    "binding_source": "git_blob_sha_of_config/taste_result_contract.json",
    "fit_binding_remains_independent": true,
    "legacy_entries_without_v5_evidence_remain_fit_reusable": true,
    "ambiguous_legacy_entries_require_evidence_backfill": true,
    "evidence_backfill_preserves": [
      "verdict",
      "fit_level",
      "reason_code",
      "positive_evidence",
      "taste_factors",
      "profile_blob_sha",
      "taste_model_version",
      "taste_semantics_sha256",
      "taste_fingerprint",
      "candidate_context_sha256",
      "evaluated_at_utc"
    ]
  }
}
