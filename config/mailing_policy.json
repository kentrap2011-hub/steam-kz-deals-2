{
  "contract": "GAME-DEALS-MAILING",
  "version": "1.5",
  "status": "canonical",
  "purpose": "Single source of truth for the personalized daily game-deals mailing.",

  "policy_loading": {
    "primary_repository": "kentrap2011-hub/steam-kz-deals-2",
    "primary_path": "config/mailing_policy.json",
    "primary_method": "github_connector_or_github_contents",
    "raw_fallback_url": "https://raw.githubusercontent.com/kentrap2011-hub/steam-kz-deals-2/main/config/mailing_policy.json",
    "web_cached_copy_is_not_authoritative": true,
    "if_sources_disagree": "github_repository_copy_wins",
    "do_not_start_ingest_before_canonical_policy_loaded": true,
    "fail_if_canonical_policy_unavailable": true
  },

  "delivery": {
    "mode": "full_daily_snapshot",
    "delta_only": false,
    "repeat_still_active_relevant_deals_each_day": true,
    "fixed_top_n": null,
    "completed_games_auto_excluded": false,
    "completed_status_is_context_only": true
  },

  "taste_profile": {
    "canonical_url": "https://raw.githubusercontent.com/kentrap2011-hub/stopgame-ratings-data/main/gaming_taste_live.json",
    "load_once_per_run": true,
    "historical_snapshot_forbidden_as_fallback": "gaming_taste_database_2026-08-12.json",
    "ratings_optional_context": "ratings.json",
    "wishlist_optional_context": "steam_wishlist.json",
    "wishlist_is_discovery_source": false,
    "wishlist_is_taste_proof": false,
    "fail_if_canonical_profile_unavailable": true
  },

  "paid_discovery": {
    "repository": "kentrap2011-hub/steam-kz-deals-2",
    "store": "Steam",
    "region": "Kazakhstan",
    "country_code": "kz",
    "manifest_path": "data/production/manifest.json",
    "source_shortlist_index_path": "data/production/shortlist/index.json",
    "mailing_optimized_index_path": "data/production/mailing/index.json",
    "prefer_mailing_optimized_view": true,
    "safe_fallback_to_source_shortlist": true,
    "optimized_view_is_not_a_new_discovery_source": true,
    "format_source": "chosen_fresh_index",
    "chunk_pattern_source": "chosen_fresh_index",
    "read_all_chunks": true,
    "production_feed_is_primary_discovery_source": true,
    "steamdb_for_discovery": false,
    "web_search_may_replace_failed_ingest": false
  },

  "ingest_qa": {
    "fail_closed": true,
    "manifest_complete_required": true,
    "minimum_coverage_ratio": 0.99,
    "needs_tuning_must_be_false": true,
    "maximum_snapshot_age_hours": 18,
    "source_index_complete_required": true,
    "minimum_source_index_coverage_ratio": 0.99,
    "source_index_needs_tuning_must_be_false": true,
    "require_country_code_kz": true,
    "require_all_chunks": true,
    "require_actual_chunk_count_equals_index_chunk_count": true,
    "require_actual_data_rows_equals_item_count": true,
    "source_tsv_chunks_have_header": false,
    "mailing_tsv_chunks_have_header": false,
    "optimized_view_must_match_source_item_count": true,
    "optimized_view_must_match_source_updated_at": true,
    "optimized_view_must_report_all_source_chunks_verified": true,
    "optimized_view_mismatch_action": "fallback_to_source_shortlist",
    "on_source_failure": "do_not_generate_any_mailing",
    "no_partial_freebies_or_upcoming_on_failure": true
  },

  "personal_filter": {
    "minimum_interest_threshold": "moderate",
    "broad_filtering": true,
    "do_not_limit_to_aaa": true,
    "do_not_limit_to_action_adventure": true,
    "do_not_limit_by_genre_popularity_or_age": true,
    "completed_game_is_not_exclusion_reason": true,
    "feed_reason_role": "recall_and_supporting_evidence_only",
    "feed_signals_never_auto_include": true,
    "strong_fit_is_not_final_taste_verdict": true,
    "allow_analogical_fit_from_profile": true,
    "do_not_require_exact_title_or_exact_tag_match": true,
    "moderate_fit_rule": "INCLUDE when the candidate is at least moderately likely to interest the user after comparing its available metadata with the full canonical taste profile. Moderate fit may be inferred by analogy to multiple durable positive patterns or examples; a direct title match is not required.",
    "mixed_evidence_rule": "Do not treat a mixed cluster as negative by default. When the profile contains both liked and disliked games with broadly similar tags or structure, compare the candidate against both sides. If at least two independent durable positive analogies are supported by the candidate metadata or feed fit signals and there is no direct strong negative user evidence, the candidate reaches at least moderate fit unless a specific contradictory mechanic or structure is known.",
    "sparse_metadata_rule": "Sparse generic tags such as Action or Open World are not enough to reject a candidate. For a taste-based EXCLUDE with sparse metadata, combine core_fit_count, feed fit signals and relevant positive/negative anchors from the canonical profile. If the evidence remains genuinely balanced, route to targeted audit.",
    "unknown_is_not_automatic_include": true,
    "below_moderate_fit_is_valid_exclusion": true,
    "reasonable_uncertainty_rule": "When meaningful positive and negative evidence place a candidate near the moderate threshold, treat it as borderline and route it to the targeted local audit instead of silently discarding it or automatically including it.",
    "exclusion_requires_specific_reason": true,
    "valid_exclusion_reason_codes": [
      "below_moderate_fit",
      "direct_strong_negative_user_evidence",
      "sale_confirmed_inactive",
      "price_clearly_unreasonable_even_after_soft_target_evaluation",
      "not_a_game_or_not_relevant_game_content",
      "inferior_duplicate_variant_after_offer_family_resolution",
      "borderline_fit_needs_audit"
    ]
  },

  "decision_ledger": {
    "required": true,
    "scope": "every_ingested_candidate",
    "allowed_decisions": ["INCLUDE", "EXCLUDE"],
    "exclude_requires_reason": true,
    "exclude_reason_must_use_specific_reason_code": true,
    "include_requires_fit_level": true,
    "require_included_plus_excluded_equals_processed_candidates": true,
    "keep_internal_unless_debug_requested": true
  },

  "false_negative_audit": {
    "required": true,
    "mode": "targeted_local_conflict_audit",
    "external_lookups_during_audit": false,
    "do_not_reaudit_nearly_all_excludes": true,
    "compound_recall_signals": ["strong_fit", "strong_niche_fit"],
    "supporting_signals": ["exceptional_discount", "very_high_rating", "recent_fit", "substantive_content", "high_confidence_adjacent"],
    "audit_when": [
      "exclude_reason_is_borderline_fit_needs_audit",
      "exclude_reason_is_missing_ambiguous_or_not_specific",
      "candidate_has_strong_fit_or_strong_niche_fit_and_core_fit_count_at_least_1_and_at_least_one_supporting_signal_and_exclusion_is_taste_based",
      "candidate_has_multiple_independent_profile_analogies_but_first_pass_excluded_it",
      "candidate_has_sparse_generic_tags_but_core_fit_count_at_least_2_and_compound_recall_signal_and_taste_based_exclusion",
      "offer_family_would_disappear_even_though_a_related_variant_has_compound_positive_fit_evidence"
    ],
    "do_not_audit_only_because": [
      "strong_fit_alone",
      "strong_niche_fit_alone",
      "very_high_rating_alone",
      "exceptional_discount_alone",
      "popularity_alone",
      "age_or_newness_alone"
    ],
    "direct_strong_negative_user_evidence_skips_audit_unless_contradictory_newer_user_evidence_exists": true,
    "audit_verdict_rule": "If the local second pass finds at least two independent durable positive analogies and no direct strong negative user evidence or known contradictory mechanic, classify at least moderate fit. Feed signals support this judgment but never force INCLUDE by themselves.",
    "rule": "Re-evaluate only the conflicting candidate against the canonical taste profile and its local feed metadata. If the evidence reaches at least moderate likely interest, change it to INCLUDE. Otherwise keep EXCLUDE with a specific reason. Do not use Store, SteamDB or web lookups to decide taste fit.",
    "no_candidate_name_whitelists": true,
    "no_control_game_names_in_policy": true
  },

  "offer_family_resolution": {
    "required": true,
    "group_related_offers_before_expensive_external_checks": true,
    "families": [
      "base_game",
      "remaster_or_remake",
      "deluxe_gold_complete_ultimate_definitive",
      "substantive_dlc",
      "season_or_expansion_pass",
      "bundle",
      "franchise_bundle",
      "complete_the_set"
    ],
    "family_detection_rules": [
      "rows_with_the_same_appid_but_different_App_or_Sub_keys_belong_to_the_same_purchase_family",
      "normalize_titles_by_removing_trademark_symbols_and_edition_suffixes_such_as_remastered_remake_deluxe_gold_complete_ultimate_definitive_full_package_goty_collection_bundle",
      "rows_with_the_same_normalized_base_title_may_be_grouped_when_the_relationship_is_clear",
      "do_not_merge_merely_because_titles_share_a_franchise_word"
    ],
    "sub_rows_are_purchase_variants_not_noise": true,
    "compare_all_local_variants_in_an_included_family": true,
    "choose_best_purchase_variant": true,
    "best_variant_factors": [
      "contains_the_recommended_base_content",
      "substantive_extra_content",
      "current_price",
      "discount",
      "historical_price_quality_when_available",
      "small_incremental_cost_for_materially_more_content"
    ],
    "prefer_complete_variant_when_incremental_cost_is_small_and_content_is_material": true,
    "do_not_assume_base_game_is_best": true,
    "do_not_drop_a_game_family_because_one_variant_is_weaker": true,
    "family_safety_rule": "If a family would disappear but one or more related variants carry compound positive fit evidence, run the local family audit before dropping the family. This does not force INCLUDE.",
    "one_primary_output_row_per_purchase_family": true,
    "primary_row_must_use_best_purchase_variant": true,
    "mention_useful_alternative_variant_in_same_row_when_relevant": true,
    "store_check_scope": "For a final INCLUDE family, one Store-family check should verify the selected variant and any materially competitive bundle/edition instead of separate duplicate lookups per row."
  },

  "pricing": {
    "target_rub": 500,
    "target_is_hard_cap": false,
    "small_overage_allowed_if_still_good_value": true,
    "user_visible_currency": "RUB",
    "show_foreign_currency_to_user": false,
    "mark_converted_amounts_approximate": true
  },

  "verification": {
    "production_feed_for_initial_current_price_and_discount": true,
    "steam_store_final_check_for_included_candidates": true,
    "steam_store_wins_current_price_discount_or_active_status_conflict": true,
    "exclude_if_steam_store_confirms_sale_ended": true,
    "steamdb_usage": "history_only_after_personal_selection",
    "steamdb_region": "Kazakhstan",
    "check_historical_minimum": true,
    "check_sale_end_date": true,
    "if_final_check_unavailable_mark_unverified_instead_of_inventing": true,
    "taste_fit_must_be_final_before_external_checks": true
  },

  "external_cache": {
    "enabled_when_available": true,
    "store_cache_path": "data/production/cache/store_cache.json",
    "steamdb_cache_path": "data/production/cache/steamdb_cache.json",
    "cache_is_never_discovery_source": true,
    "store_cache_reuse_rule": "Reuse a cached Store result when app/family identity, current production-feed price and discount still match and cached sale_end is still in the future.",
    "steamdb_cache_reuse_rule": "Reuse historical minimum indefinitely unless the current verified price is below the cached minimum or cache integrity is uncertain.",
    "cache_miss_action": "perform_normal_finalist_lookup",
    "cache_failure_action": "do_not_fail_source_ingest; fall back to normal finalist lookup"
  },

  "runtime_optimization": {
    "goal": "Minimize expensive network/tool calls without reducing feed completeness or recall.",
    "stage_a": "Load canonical policy from GitHub first, then profile, manifest, source index, and validated mailing-optimized index. Read each chosen chunk exactly once. No Store, SteamDB or web probes during ingest.",
    "stage_b": "In one local pass assign INCLUDE/EXCLUDE ledger decisions and normalize related SKUs into offer families. Feed reason flags are supporting signals, not automatic INCLUDE decisions.",
    "stage_c": "Run only the targeted local conflict audit conditions. The audit must not make external network lookups.",
    "stage_d": "After fit and family resolution are final, use valid Store cache first and query Steam Store only for final INCLUDE families that need current-state verification. Resolve bundle/edition competition at family level, not by duplicate per-row lookups.",
    "stage_e": "Use valid SteamDB history cache first and query SteamDB only for the selected best purchase variant of each final INCLUDE family, plus an alternative only when historical comparison is necessary to choose between materially competitive variants.",
    "stage_f": "Batch external checks when supported, reuse results within one offer family, and never repeat the same lookup in one run, including probe lookups.",
    "stage_g": "Run at most one promo control pass near the end as omission insurance; reuse any results already obtained.",
    "mailing_chunk_target_size": 150,
    "do_not_trade_completeness_for_speed": true
  },

  "freebies": {
    "steam_feed_path": "data/production/freebies.tsv",
    "check_epic_gog_and_other_major_legal_pc_stores": true,
    "personal_filter_required": true,
    "minimum_fit": "moderate",
    "only_after_successful_main_ingest": true,
    "silently_omit_rejected_freebies": true
  },

  "upcoming": {
    "enabled": true,
    "horizon_days": 60,
    "include_relevant_sales_and_events": true,
    "max_items": 1,
    "selection": "nearest_relevant_event_only",
    "omit_block_if_none_relevant": true,
    "distinguish_confirmed_from_estimated_dates": true,
    "only_after_successful_main_ingest": true
  },

  "output_visibility": {
    "show_only_included_recommendations": true,
    "silent_exclusions": true,
    "do_not_explain_why_rejected_games_or_freebies_were_omitted": true,
    "do_not_list_not_fit_items": true,
    "do_not_publish_internal_ledger": true,
    "do_not_emit_candidate_names_in_progress_messages_before_final_verification": true,
    "technical_debug_stats_only_when_explicitly_requested": true
  },

  "sorting": {
    "required": true,
    "do_not_preserve_feed_or_processing_order": true,
    "purchase_decision_order": ["БРАТЬ СЕЙЧАС", "МОЖНО БРАТЬ", "ЛУЧШЕ ЖДАТЬ"],
    "within_decision_order": [
      "taste_fit_desc",
      "price_quality_vs_history_desc",
      "best_variant_value_desc",
      "discount_percent_desc",
      "current_price_rub_asc",
      "title_asc"
    ],
    "price_quality_order": ["record", "near_record", "good_vs_history", "unverified", "well_above_history"],
    "do_not_sort_only_by_discount_absolute_price_popularity_or_genre": true,
    "sorting_must_be_applied_after_final_verification_and_family_resolution": true
  },

  "paid_output_fields": [
    "title",
    "best_edition_or_bundle",
    "discount_percent",
    "current_price_rub",
    "historical_minimum_rub_kazakhstan",
    "delta_vs_historical_minimum",
    "record_or_near_record_status",
    "sale_end_date",
    "buy_now_or_wait",
    "why_it_fits"
  ],

  "final_self_check": {
    "policy_loaded_from_canonical_repository_before_ingest": true,
    "profile_loaded": true,
    "production_qa_passed": true,
    "all_chosen_chunks_read": true,
    "rows_equal_item_count": true,
    "optimized_view_if_used_matches_source": true,
    "ledger_covers_every_processed_candidate": true,
    "feed_signals_not_used_as_automatic_include": true,
    "targeted_local_false_negative_audit_completed": true,
    "required_compound_signal_excludes_audited": true,
    "sparse_metadata_conflicts_audited": true,
    "no_candidate_name_whitelists": true,
    "taste_fit_final_before_external_checks": true,
    "offer_families_resolved_before_external_checks": true,
    "all_included_families_compared_for_local_bundle_and_edition_variants": true,
    "one_primary_row_per_purchase_family": true,
    "primary_rows_use_best_purchase_variant": true,
    "deterministic_sort_applied": true,
    "no_artificial_top_n": true,
    "completed_games_not_auto_excluded": true,
    "still_active_deals_not_hidden_because_shown_yesterday": true,
    "wishlist_not_used_for_discovery": true,
    "steamdb_not_used_for_discovery": true,
    "no_duplicate_external_lookups": true,
    "all_user_visible_money_in_rub": true,
    "excluded_items_not_mentioned": true,
    "upcoming_items_at_most_one": true,
    "freebies_and_upcoming_only_after_successful_ingest": true
  }
}
