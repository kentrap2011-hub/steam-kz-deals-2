{
  "contract": "GAME-DEALS-MAILING",
  "version": "1.10",
  "status": "canonical",
  "purpose": "Personalized full daily Steam KZ deals mailing with stable price-blind taste verdicts and resumable taste-cache checkpoints.",

  "policy_loading": {
    "primary_repository": "kentrap2011-hub/steam-kz-deals-2",
    "primary_path": "config/mailing_policy.json",
    "primary_method": "github_connector_or_github_contents",
    "raw_fallback_url": "https://raw.githubusercontent.com/kentrap2011-hub/steam-kz-deals-2/main/config/mailing_policy.json",
    "web_cached_copy_is_not_authoritative": true,
    "github_copy_wins_on_disagreement": true,
    "load_before_any_ingest": true,
    "fail_closed_if_unavailable": true
  },

  "delivery": {
    "mode": "full_daily_snapshot",
    "delta_only": false,
    "repeat_still_active_relevant_deals_each_day": true,
    "fixed_top_n": null,
    "completed_games_auto_excluded": false,
    "completed_status_is_context_only": true
  },

  "taste_profile": {
    "canonical_repository": "kentrap2011-hub/stopgame-ratings-data",
    "canonical_path": "gaming_taste_live.json",
    "load_once_per_run": true,
    "record_git_blob_sha": true,
    "historical_snapshot_forbidden_as_fallback": "gaming_taste_database_2026-08-12.json",
    "wishlist_optional_context": "steam_wishlist.json",
    "wishlist_is_discovery_source": false,
    "wishlist_is_taste_proof": false,
    "wishlist_is_ownership_proof": false,
    "fail_if_canonical_profile_unavailable": true
  },

  "paid_discovery": {
    "repository": "kentrap2011-hub/steam-kz-deals-2",
    "store": "Steam",
    "region": "Kazakhstan",
    "country_code": "kz",
    "manifest_path": "data/production/manifest.json",
    "source_index_path": "data/production/shortlist/index.json",
    "mailing_optimized_index_path": "data/production/mailing/index.json",
    "prefer_mailing_optimized_view": true,
    "safe_fallback_to_source_shortlist": true,
    "optimized_view_is_not_a_new_discovery_source": true,
    "production_feed_is_primary_discovery_source": true,
    "steamdb_for_discovery": false,
    "web_search_may_replace_failed_ingest": false,
    "read_all_chunks": true
  },

  "ingest_qa": {
    "fail_closed": true,
    "manifest_complete_required": true,
    "minimum_coverage_ratio": 0.99,
    "needs_tuning_must_be_false": true,
    "maximum_snapshot_age_hours": 18,
    "source_index_complete_required": true,
    "minimum_source_index_coverage_ratio": 0.99,
    "source_index_needs_tuning_must_be_false": true,
    "require_country_code_kz": true,
    "require_all_chunks": true,
    "require_actual_chunk_count_equals_index": true,
    "require_actual_rows_equals_item_count": true,
    "mailing_and_source_tsv_have_no_header": true,
    "optimized_view_must_match_source_item_count": true,
    "optimized_view_must_match_source_updated_at": true,
    "optimized_view_must_report_all_source_chunks_verified": true,
    "optimized_mismatch_action": "fallback_to_source_shortlist",
    "source_failure_action": "do_not_generate_any_mailing",
    "no_partial_freebies_or_upcoming_on_failure": true
  },

  "taste_deal_separation": {
    "required": true,
    "taste_verdict_is_price_blind": true,
    "forbidden_as_positive_taste_evidence": [
      "discount_percent",
      "final_kzt",
      "global_review_positive",
      "global_review_count",
      "russian_review_positive",
      "russian_review_count",
      "exceptional_discount",
      "very_high_rating",
      "mainstream_quality",
      "popular_quality",
      "cheap_quality",
      "steamdb_history",
      "historical_minimum",
      "sale_end_date"
    ],
    "recall_only_feed_flags": ["strong_fit", "strong_niche_fit", "recent_fit", "high_confidence_adjacent"],
    "recall_flags_can_trigger_audit_but_are_not_taste_evidence": true,
    "core_fit_count_is_recall_context_not_positive_taste_evidence": true,
    "deal_quality_can_never_raise_taste_fit": true,
    "deal_quality_evaluated_only_after_final_taste_and_family_resolution": true
  },

  "personal_filter": {
    "minimum_interest_threshold": "moderate",
    "broad_filtering": true,
    "do_not_limit_by_aaa_genre_popularity_or_age": true,
    "completed_game_is_not_exclusion_reason": true,
    "allow_analogical_fit_from_profile": true,
    "do_not_require_exact_title_match": true,
    "no_automatic_include_from_feed_signals": true,
    "do_not_invent_unknown_game_properties": true,

    "evidence_contract": {
      "every_positive_evidence_item_must_pair": [
        "a_specific_candidate_property",
        "a_specific_canonical_profile_anchor_or_durable_pattern"
      ],
      "generic_tags_that_cannot_count_alone": [
        "Action", "Adventure", "RPG", "Singleplayer", "Story Rich", "Open World",
        "Horror", "Exploration", "Third Person", "Fantasy", "Sci-fi", "Narrative", "Combat"
      ],
      "high_specificity_positive_types": [
        "direct_positive_evidence_for_this_candidate_in_canonical_profile",
        "positive_same_series_anchor_with_clear_mechanical_or_structural_continuity",
        "high_confidence_intrinsic_mechanic_or_structure_of_candidate_mapped_to_a_canonical_positive_pattern"
      ],
      "supporting_positive_types": [
        "second_distinct_intrinsic_mechanic_or_structure_mapped_to_another_canonical_positive_pattern",
        "specific_non_generic_metadata_cluster_mapped_to_a_canonical_factor",
        "mastery_or_shared_play_match_when_intrinsically_relevant"
      ],
      "negative_types": [
        "direct_strong_negative_user_evidence",
        "negative_same_series_anchor_when_formula_continuity_is_clear",
        "known_specific_structure_conflicting_with_a_durable_negative_pattern"
      ],
      "same_series_mixed_evidence_requires_candidate_specific_resolution": true,
      "generic_tag_plus_generic_tag_is_not_two_independent_signals": true,
      "one_feed_recall_flag_plus_one_profile_pattern_is_not_two_signals": true
    },

    "structured_taste_evaluation": {
      "taste_model_version": "taste-v2",
      "required_for_cache_miss": true,
      "include_moderate_if": "Either (A) at least 1 high-specificity positive evidence item plus at least 1 independent additional substantive positive item, or (B) at least 3 independent substantive specific positive items from distinct canonical factors. In both cases at least one positive item must concern gameplay/mechanics/structure rather than only theme, story premise or art, and there must be no direct strong negative user evidence or clearly dominant specific structural conflict.",
      "direct_strong_negative_can_block": true,
      "known_specific_structural_conflict_can_block": true,
      "if_only_generic_metadata_or_vague_analogy": "below_moderate_fit",
      "if_candidate_properties_are_unknown_and_no_direct_or_same_series_anchor": "below_moderate_fit",
      "if_exactly_one_substantive_positive_and_no_clear_negative": "borderline_fit_needs_audit",
      "audit_may_not_lower_the_same_include_threshold": true,
      "reviews_discount_price_never_break_tie": true
    },

    "unknown_is_not_automatic_include": true,
    "exclusion_requires_specific_reason": true,
    "valid_exclusion_reason_codes": [
      "below_moderate_fit",
      "direct_strong_negative_user_evidence",
      "not_a_game_or_not_relevant_game_content",
      "ineligible_dlc_or_addon_without_relevant_base_context",
      "inferior_duplicate_variant_after_offer_family_resolution",
      "sale_confirmed_inactive",
      "price_clearly_unreasonable_after_soft_target_evaluation",
      "borderline_fit_needs_audit"
    ]
  },

  "decision_ledger": {
    "required": true,
    "scope": "every_ingested_candidate",
    "allowed_decisions": ["INCLUDE", "EXCLUDE"],
    "exclude_requires_specific_reason_code": true,
    "include_requires_fit_level": true,
    "included_plus_excluded_must_equal_processed": true,
    "keep_internal_unless_debug_requested": true
  },

  "false_negative_audit": {
    "required": true,
    "mode": "targeted_price_blind_taste_audit",
    "external_lookups_during_audit": false,
    "do_not_reaudit_nearly_all_excludes": true,
    "audit_when": [
      "exclude_reason_is_borderline_fit_needs_audit",
      "exclude_reason_is_missing_ambiguous_or_not_specific",
      "strong_fit_or_strong_niche_fit_recall_flag_conflicts_with_taste_based_exclusion",
      "core_fit_count_at_least_2_with_sparse_metadata_and_taste_based_exclusion",
      "candidate_has_multiple_grounded_profile_analogies_but_first_pass_excluded_it"
    ],
    "audit_uses_same_evidence_contract_and_same_threshold": true,
    "recall_flags_are_not_positive_taste_evidence": true,
    "price_reviews_discount_store_steamdb_forbidden": true,
    "direct_strong_negative_skips_audit_unless_newer_contradictory_user_evidence_exists": true,
    "no_candidate_name_whitelists": true,
    "no_control_game_names_in_policy": true
  },

  "taste_cache": {
    "path": "data/cache/taste_fit.json",
    "schema_version": 1,
    "purpose": "derived verdict cache only; never user evidence and never a second taste profile",
    "taste_model_version": "taste-v2",
    "keying": "exact production candidate key",
    "profile_binding": "canonical gaming_taste_live.json Git blob SHA must match exactly",
    "fingerprint_fields": [
      "key",
      "appid",
      "normalized_title_for_taste",
      "sorted_fit_tags",
      "core_fit_count",
      "release_date"
    ],
    "fingerprint_excludes": [
      "discount_percent", "final_kzt", "review_scores", "review_counts",
      "feed_reason_flags", "historical_price", "sale_end_date"
    ],
    "required_entry_fields": [
      "key", "appid", "profile_blob_sha", "taste_model_version", "taste_fingerprint",
      "verdict", "fit_level", "reason_code", "positive_evidence", "negative_evidence",
      "evaluated_at_utc"
    ],
    "cache_hit_requires": ["exact_key", "profile_blob_sha", "taste_model_version", "taste_fingerprint"],
    "cache_hits_are_final_and_not_semantically_re_evaluated": true,
    "profile_sha_change_invalidates_old_generation": true,
    "do_not_cache_borderline_before_audit": true,
    "entry_count_must_equal_len_entries": true,

    "checkpoint_strategy": {
      "mode": "incremental_by_chosen_feed_chunk",
      "required_on_cache_misses": true,
      "process_chunks_in_source_order": true,
      "checkpoint_after_each_chunk_final_post_audit_verdicts": true,
      "merge_only_final_non_borderline_entries": true,
      "checkpoint_before_advancing_to_next_chunk_when_cache_changed": true,
      "checkpoint_before_content_family_store_steamdb_deal_quality_sorting": true,
      "maximum_github_writes_per_run": "chosen_feed_chunk_count",
      "steady_state_goal": "zero_or_one_write_when_few_or_no_misses",
      "write_failure_is_warning_only": true,
      "if_execution_budget_is_low_stop_after_successful_checkpoint_and_resume_next_run": true,
      "never_discard_already_persisted_valid_chunk_verdicts": true
    },

    "recovery_artifact": {
      "enabled": true,
      "expected_name": "taste_fit_checkpoint_prepared.json",
      "purpose": "recover final taste-v2 verdicts from an immediately prior interrupted run without repeating semantic evaluation",
      "artifact_is_not_user_evidence": true,
      "accept_only_if": [
        "schema_version_matches",
        "profile_blob_sha_matches_current_canonical_profile",
        "taste_model_version_matches_current_policy",
        "every_recovered_entry_key_exists_in_current_feed",
        "every_recovered_entry_fingerprint_matches_current_price_blind_fingerprint",
        "every_recovered_entry_is_final_non_borderline",
        "artifact_entry_count_equals_len_entries"
      ],
      "full_artifact_fast_path": "If a valid recovery artifact covers every current feed candidate, write it to data/cache/taste_fit.json before any semantic re-evaluation, then treat all matching entries as cache hits.",
      "partial_artifact_rule": "Merge only individually valid recovered entries, persist them as an incremental checkpoint, and semantically evaluate only remaining misses.",
      "recovery_write_counts_against_checkpoint_write_budget": true,
      "if_validation_fails": "ignore_artifact_and_use_normal_cache_miss_flow"
    }
  },

  "content_eligibility": {
    "required": true,
    "dlc_is_not_independent_recommendation_by_default": true,
    "dlc_or_chapter_include_only_if": [
      "base_game_family_is_taste_include_in_same_run",
      "canonical_profile_or_current_user_context_directly_supports_base_game",
      "addon_is_effectively_standalone_game_like_content_and_itself_meets_taste_threshold"
    ],
    "wishlist_not_ownership": true,
    "cosmetic_soundtrack_artbook_and_non_game_addons_excluded": true,
    "bundle_with_base_game_may_be_purchase_variant_of_included_family": true
  },

  "offer_family_resolution": {
    "required": true,
    "group_before_expensive_external_checks": true,
    "family_types": [
      "base_game", "remaster_or_remake", "deluxe_gold_complete_ultimate_definitive",
      "substantive_dlc", "season_or_expansion_pass", "bundle", "franchise_bundle", "complete_the_set"
    ],
    "same_appid_app_and_sub_may_be_purchase_family_when_relationship_clear": true,
    "normalize_common_edition_suffixes": true,
    "do_not_merge_only_because_of_shared_franchise_word": true,
    "sub_rows_are_purchase_variants_not_noise": true,
    "compare_all_local_variants_in_included_family": true,
    "choose_best_purchase_variant": true,
    "best_variant_factors": [
      "contains_recommended_base_content", "substantive_extra_content", "current_price",
      "discount", "historical_price_quality_if_available", "incremental_cost_for_more_content"
    ],
    "prefer_complete_variant_when_small_increment_adds_material_content": true,
    "one_primary_output_row_per_purchase_family": true,
    "primary_row_uses_best_purchase_variant": true,
    "mention_useful_alternative_in_same_row_when_relevant": true
  },

  "pricing": {
    "target_rub": 500,
    "target_is_hard_cap": false,
    "small_overage_allowed_if_good_value": true,
    "user_visible_currency": "RUB",
    "show_foreign_currency_to_user": false,
    "converted_amounts_are_approximate": true,
    "historical_zero": {
      "zero_means_previously_free_not_paid_minimum": true,
      "do_not_compute_paid_delta_from_zero": true,
      "do_not_force_wait_because_once_free": true,
      "display_as_previously_free": true
    }
  },

  "verification": {
    "fresh_production_snapshot_is_current_price_and_discount_source": true,
    "steam_store_live_check_mode": "conditional_only",
    "steam_store_live_check_triggers": [
      "current_source_conflict",
      "materially_competitive_bundle_or_edition_unresolved_locally",
      "sale_end_date_material_to_verdict_and_not_cached",
      "one_final_promo_control_pass"
    ],
    "do_not_query_store_only_to_repeat_fresh_price_or_discount": true,
    "sale_end_date_optional": true,
    "live_store_wins_on_current_conflict": true,
    "live_store_confirmed_ended_sale_excluded": true,
    "steamdb_usage": "history_only_after_personal_selection",
    "steamdb_region": "Kazakhstan",
    "taste_fit_must_be_final_before_external_checks": true
  },

  "external_cache": {
    "load_each_cache_at_most_once_per_run": true,
    "cache_is_never_discovery_source": true,

    "store_state": {
      "path": "data/cache/store_state.json",
      "source": "same validated Steam KZ production snapshot",
      "validate_against_chosen_source_index": true,
      "do_not_reread_per_candidate": true
    },

    "steamdb_history": {
      "path": "data/cache/steamdb_history.json",
      "writer_schema_version": 2,
      "accept_legacy_schema_version_1": true,
      "currency": "KZT",
      "keying": "exact App_/Sub_ key",
      "status_values": ["confirmed_min", "previously_free", "unavailable_exact_history"],
      "legacy_v1_positive_value_is_confirmed_min": true,
      "legacy_v1_zero_is_previously_free": true,
      "confirmed_min_reuse_if_current_price_not_below_cached_min": true,
      "previously_free_reuse_without_requery_only_for_zero": true,
      "negative_cache": {
        "status": "unavailable_exact_history",
        "ttl_days": 14,
        "persist_only_if_source_reached_and_exact_history_confirmed_unavailable": true,
        "unexpired_entry_skips_lookup": true,
        "blocked_timeout_tool_failure_never_persisted_as_negative": true
      },
      "lookup_required_when": [
        "entry_missing", "entry_invalid", "negative_ttl_expired", "current_price_below_cached_nonzero_min"
      ],
      "actual_runtime_entry_count_is_len_entries": true,
      "never_trust_stale_metadata_entry_count": true,
      "repair_metadata_on_next_permitted_write": true,
      "at_most_one_github_write_per_run_if_changed": true,
      "do_not_store_guessed_minima": true,
      "write_failure_is_warning_only": true
    },

    "lookup_registry": {
      "required": true,
      "key": "provider_plus_exact_entity_key",
      "record_success_failure_blocked_and_unavailable_first_attempt": true,
      "never_repeat_same_key_in_run": true,
      "shared_across_all_external_stages": true
    }
  },

  "runtime_pipeline": [
    "1_load_canonical_policy",
    "2_load_profile_once_and_record_blob_sha",
    "3_validate_and_read_full_feed_once",
    "4_load_taste_cache_once_and_validate_optional_recovery_artifact",
    "5_if_full_valid_recovery_artifact_exists_checkpoint_it_before_semantic_work",
    "6_process_taste_cache_misses_in_feed_chunk_order",
    "7_after_each_chunk_finalize_targeted_audit_and_checkpoint_changed_final_verdicts",
    "8_only_after_all_current_candidates_have_final_taste_verdicts_apply_content_eligibility_and_offer_family_resolution",
    "9_current_price_discount_from_validated_snapshot_and_conditional_store_only",
    "10_steamdb_cache_then_true_history_misses_only",
    "11_at_most_one_steamdb_cache_write",
    "12_deal_quality_and_deterministic_sort",
    "13_freebies_and_one_upcoming_event",
    "14_final_self_check_then_publish"
  ],

  "freebies": {
    "steam_feed_path": "data/production/freebies.tsv",
    "check_epic_gog_and_other_major_legal_pc_stores": true,
    "personal_filter_required": true,
    "minimum_fit": "moderate",
    "only_after_successful_main_ingest": true,
    "silently_omit_rejected_freebies": true
  },

  "upcoming": {
    "enabled": true,
    "horizon_days": 60,
    "max_items": 1,
    "selection": "nearest_relevant_event_only",
    "omit_if_none_relevant": true,
    "distinguish_confirmed_from_estimated_dates": true,
    "only_after_successful_main_ingest": true
  },

  "output_visibility": {
    "show_only_included_recommendations": true,
    "silent_exclusions": true,
    "do_not_explain_rejected_games_or_freebies": true,
    "do_not_publish_internal_ledger": true,
    "do_not_emit_candidate_names_in_progress_before_final_verification": true,
    "technical_debug_stats_only_when_requested": true
  },

  "sorting": {
    "required": true,
    "do_not_preserve_feed_or_processing_order": true,
    "purchase_decision_order": ["БРАТЬ СЕЙЧАС", "МОЖНО БРАТЬ", "ЛУЧШЕ ЖДАТЬ"],
    "within_decision_order": [
      "taste_fit_desc", "price_quality_vs_history_desc", "best_variant_value_desc",
      "discount_percent_desc", "current_price_rub_asc", "title_asc"
    ],
    "price_quality_order": ["record", "near_record", "good_vs_history", "previously_free", "unverified", "well_above_history"],
    "apply_after_final_verification_and_family_resolution": true
  },

  "paid_output_fields": [
    "title", "best_edition_or_bundle", "discount_percent", "current_price_rub",
    "historical_minimum_rub_or_previously_free", "delta_vs_paid_historical_minimum_if_available",
    "record_or_near_record_status", "sale_end_date_if_known", "buy_now_or_wait", "why_it_fits"
  ],

  "final_self_check": {
    "policy_loaded_before_ingest": true,
    "profile_loaded_once_and_blob_sha_recorded": true,
    "production_qa_passed": true,
    "all_chosen_chunks_read": true,
    "rows_equal_item_count": true,
    "ledger_covers_all_candidates": true,
    "taste_verdicts_price_blind": true,
    "generic_tags_feed_flags_reviews_and_deal_quality_not_counted_as_taste_evidence": true,
    "taste_cache_consulted_before_semantic_evaluation": true,
    "taste_cache_hits_not_re_evaluated": true,
    "fresh_taste_verdicts_use_taste_v2_evidence_contract": true,
    "targeted_audit_uses_same_threshold": true,
    "valid_recovery_artifact_entries_verified_before_reuse": true,
    "each_changed_taste_chunk_checkpointed_before_advancing_or_external_work": true,
    "already_persisted_valid_taste_verdicts_not_discarded_on_interruption": true,
    "no_candidate_name_whitelists": true,
    "content_eligibility_applied": true,
    "orphan_dlc_not_recommended": true,
    "taste_fit_final_before_external_checks": true,
    "one_primary_row_per_purchase_family": true,
    "primary_row_uses_best_purchase_variant": true,
    "fresh_snapshot_or_conditional_store_used_for_current_state": true,
    "steamdb_cache_consulted_before_history_lookup": true,
    "steamdb_actual_len_entries_used": true,
    "unexpired_negative_history_cache_respected": true,
    "historical_zero_not_used_as_paid_delta": true,
    "lookup_registry_used_for_all_external_calls": true,
    "no_duplicate_external_lookups": true,
    "deterministic_sort_applied": true,
    "no_artificial_top_n": true,
    "completed_not_auto_excluded": true,
    "still_active_relevant_deals_repeat_daily": true,
    "wishlist_not_used_for_discovery_taste_or_ownership": true,
    "steamdb_not_used_for_discovery": true,
    "all_visible_money_in_rub": true,
    "excluded_items_not_mentioned": true,
    "upcoming_at_most_one": true,
    "freebies_and_upcoming_after_successful_ingest": true
  }
}
