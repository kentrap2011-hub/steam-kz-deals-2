{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-PARALLEL-VALIDATION-CONTRACT-V1",
  "version": 1,
  "status": "active",
  "owner": "github_control_plane",
  "parent_contract": "TASTE-STEAM-REVIEW-DOSSIER-CONTRACT-V2",
  "purpose": "Define asynchronous GitHub-owned strict validation of immutable create-only Taste dossier candidates while canonical per-group progress accepts valid groups independently and records invalid groups for separate recovery.",
  "candidate_publication": {
    "owner": "scheduled_chatgpt_dossier_worker",
    "mode": "immutable_create_only_group_candidate",
    "group_size_source": "parent_contract.checkpointing.checkpoint_size",
    "required_group_size": 3,
    "scheduled_worker_repository_code_execution_required": false,
    "scheduled_worker_manual_validator_required": false,
    "publication_means_canonical_acceptance": false,
    "same_invocation_rule": "after_successful_create_only_publication_the_worker_may_continue_to_the_next_pending_predeclared_group_while_snapshot_group_plan_and_compatibility_binding_remain_live_without_waiting_for_github_acceptance"
  },
  "github_validation": {
    "owner": "github_control_plane",
    "validator": "scripts/taste_steam_review_dossier_buffered.py::validate_buffer_artifact",
    "trigger": "candidate_buffer_push_wakes_serialized_github_ingest_workflow",
    "scope": "complete_group_only",
    "partial_per_game_acceptance": false,
    "strict_validation_may_be_weakened": false,
    "independent_candidate_validation": "every_present pending current-snapshot candidate is strict-validated independently",
    "canonical_acceptance_rule": "each_valid_pending_group_is_accepted_independently_even_if_an_earlier_different_group_failed",
    "invalid_expected_group_rule": "an_invalid_group_is_classified_failed_or_invalid_pending_recovery_for_that_exact_identity_and_does_not_block_later_groups",
    "candidate_mutation_on_failure": false,
    "automatic_semantic_retry_or_healing": false,
    "alternate_retry_filename": false
  },
  "validation_status": {
    "schema": "TASTE-STEAM-REVIEW-DOSSIER-PARALLEL-VALIDATION-STATUS-V2",
    "schema_version": 2,
    "path": "data/production/pre_ai/taste_steam_review_dossier_validation_status.json",
    "role": "observational_projection_of_canonical_group_progress_candidate_validation_and_failed_group_recovery_visibility",
    "required_binding": [
      "snapshot_id",
      "sequence",
      "group_sha256",
      "web_evidence_contract_binding"
    ],
    "candidate_states": [
      "valid",
      "invalid"
    ],
    "new_snapshot_supersedes_prior_status": true,
    "canonical_group_states": [
      "pending",
      "accepted",
      "failed_or_invalid_pending_recovery"
    ]
  },
  "error_philosophy": {
    "invalid_group_is_production_readiness_failure": true,
    "repair_owner": "github_control_plane_explicit_failed_group_recovery_after_normal_first_pass",
    "old_incompatible_candidates": "stale_inert_or_quarantined_through_existing_snapshot_binding_and_recovery_mechanism",
    "normal_forward_progress_blocked_by_invalid_group": false
  }
}
