  "integer_rules": {
    "json_boolean_is_integer": false,
    "schema_version": {
      "const": 2
    },
    "ttl_days": {
      "minimum": 1,
      "maximum": 60
    },
    "release_year": {
      "minimum": 1970,
      "maximum": 2100
    },
    "mention_count": {
      "minimum": 1
    }
  },
  "timestamp_rules": {
    "type": "string",
    "format": "iso8601_timezone_aware",
    "expires_equals_generated_plus_ttl_days": true,
    "fresh_at_canonical_ingest_required": true,
    "maximum_future_skew_minutes_at_ingest": 5
  },
  "identity_rules": {
    "appid_type": "string",
    "appid_pattern": "^[0-9]+$",
    "buffered_title_must_equal_descriptor_title": true,
    "work_title_must_equal_dossier_title": true,
    "release_year_required": true,
    "identity_source_ids_required": true,
    "appid_corroborator_must_equal_dossier_appid": true,
    "resolved_identity_only": true,
    "identity_source_ids_require_at_least_one_identity_role_source": true,
    "identity_role_source_must_resolve_to_exact_intended_product": true,
    "identity_role_source_must_support_resolved_title_release_year_and_appid_under_current_rules": true,
    "ordinary_player_feedback_source_must_not_masquerade_as_identity_provenance": true,
    "identity_only_source_may_count_as_player_feedback_support": false
  },
  "summary_invariants": {
    "free_form_factual_claims_allowed": false,
    "derived_from_validated_structured_findings": true,
    "canonical_derivation": "Evidence summary: {observation_count} validated structured observations; consult observations and conflicts for supported findings.",
    "observation_count_source": "final_validated_observations_array_length",
    "observation_or_conflict_text_is_not_repeated_in_summary": true
  },
  "observation_invariants": {
    "non_empty": true,
    "exact_duplicate_objects_allowed": false,
    "recurrence_minimum_mentions": {
      "strong": 5,
      "moderate": 3,
      "limited": 2,
      "anecdotal": 1
    },
    "anecdotal_exact_mentions": 1,
    "mention_count_equals_distinct_bound_player_feedback_records": true,
    "bound_player_feedback_record_source_must_be_in_observation_source_ids": true,
    "all_source_ids_must_resolve": true,
    "all_player_feedback_ids_must_resolve": true,
    "current_requires_recent_current_state_source": true,
    "historical_requires_historical_and_recent_current_state_sources": true,
    "durable_requires_durable_trait_source": true,
    "recurrence_identity_strength": {
      "stable_locator_moderate_minimum": 3,
      "stable_locator_strong_minimum": 5,
      "fallback_contributes_above_limited": false,
      "limited_uses_total_distinct_bound_records": true,
      "rule": "moderate_or_strong_recurrence_requires_the_same_numeric_threshold_of_stable_locator_records;fallback_records_may_raise_support_only_to_limited"
    }
  },
  "conflict_invariants": {
    "required_fields": [
      "statement",
      "recurrence",
      "mention_count",
      "source_ids",
      "player_feedback_ids"
    ],
    "exact_duplicate_objects_allowed": false,
    "mention_count_equals_distinct_bound_player_feedback_records": true,
    "recurrence_thresholds_equal_observation_thresholds": true,
    "bound_player_feedback_record_source_must_be_in_conflict_source_ids": true,
    "official_or_professional_context_alone_cannot_establish_recurrence": true,
    "recurrence_identity_strength": "same_as_observations"
  },
  "overall_strength_invariants": {
    "strong_requires_at_least_one_strong_observation": true,
    "moderate_requires_at_least_one_moderate_or_strong_observation": true,
    "conflict_recurrence_may_promote_overall_strength": false,
    "conflicts_remain_separate_structured_evidence": true
  },
  "provenance_relationship_invariants": {
    "feedback_item_must_match_parent_physical_surface": true,
    "same_thread_distinct_feedback_items_allowed": true,
    "reddit_parent_subreddit_and_thread_scope_must_contain_child_when_resolvable": true,
    "steam_review_and_discussion_surfaces_must_not_be_cross_bound": true,
    "known_older_child_cannot_inherit_recent_parent_freshness": true,
    "unknown_child_publication_date_preserves_existing_undated_behavior": true,
    "parent_child_language_containment": {
      "russian_child_parent_languages": [
        "russian",
        "mixed"
      ],
      "non_russian_child_parent_languages": [
        "non_russian",
        "mixed"
      ],
      "mixed_or_unknown_child_additional_containment_rule": false
    },
    "stable_steam_child_exposed_appid_must_equal_dossier_appid": true,
    "deterministic_steam_parent_child_container_identity_must_match": true
  },
  "evidence_invariants": {
    "strategy": "adaptive_multi_source_web",
    "research_state": "sufficient",
    "at_least_one_bound_player_feedback_record": true,
    "multi_source_requires_at_least_two_distinct_physical_used_player_source_refs": true,
    "single_source_only_requires_reason": true,
    "russian_found_requires_russian_player_feedback_record_used_by_observation_or_conflict": true,
    "russian_used_requires_found_and_used_status": true,
    "professional_context_cannot_be_player_feedback": true,
    "official_metadata_cannot_be_player_feedback": true,
    "aggregate_storefront_statistics_cannot_populate_mention_count": true,
    "player_feedback_record_requires_item_level_stable_locator": false,
    "obvious_url_aliases_do_not_create_distinct_feedback_or_source_identity": true,
    "legacy_review_sample_field_forbidden": true,
    "legacy_store_only_or_zero_evidence_placeholder_forbidden": true,
    "no_existence_signal_state_requires_no_bound_russian_mixed_record": true,
    "existence_established_retrieval_unresolved_is_complete_dossier": false,
    "existence_established_access_unresolved_is_complete_dossier": false,
    "existence_signal_is_player_feedback_record": false,
    "existence_signal_may_support_observation_or_conflict": false,
    "player_feedback_record_identity_modes": [
      "stable_locator",
      "transient_author_deduped"
    ],
    "stable_locator_record_requires_item_level_stable_locator": true,
    "transient_author_deduped_record_requires_concrete_item_collection_parent": true,
    "transient_author_deduped_record_has_no_persisted_item_or_profile_locator": true,
    "transient_author_deduped_cross_run_identity": false,
    "steam_store_app_page_cannot_be_player_feedback_record": true,
    "steam_store_exact_app_page_may_parent_transient_author_deduped_concrete_review_cards": true,
    "steam_store_parent_aggregate_metadata_is_non_mention_provenance_only": true,
    "multi_source_requires_single_source_reason_null": true,
    "steam_store_exact_app_fallback_parent_allowed_source_types": [
      "steam_reviews",
      "store_user_reviews"
    ],
    "steam_store_exact_app_fallback_parent_source_type_set_is_exclusive": true,
    "coverage": {
      "required_for_sufficient_evidence_stable": true,
      "all_dimensions_classified_exactly_once": true,
      "covered_dimension_requires_at_least_one_valid_observation_index": true,
      "noncovered_dimension_requires_empty_observation_indices": true,
      "materially_unresolved_forbidden_for_persisted_sufficient": true,
      "strengths_investigated_must_be_true": true,
      "weaknesses_tradeoffs_investigated_must_be_true": true,
      "exhausted_unavailable_requires_sufficient_after_route_exhaustion_closure": true,
      "compact_or_broad_requires_covered_central_experience_dimension": true,
      "route_exhaustion_closure_may_substitute_exhausted_central_dimension_for_covered_central_dimension": true,
      "fixed_numeric_completeness_score_forbidden": true
    }
  },
  "provenance_source_required_fields": [
    "source_id",
    "source_type",
    "domain",
    "publication_date",
    "language",
    "freshness",
    "evidence_role",
    "player_feedback"
  ],
  "provenance_source_allowed_fields": [
    "source_id",
    "source_type",
    "domain",
    "url",
    "public_ref",
    "publication_date",
    "language",
    "freshness",
    "evidence_role",
    "player_feedback",
    "feedback_surface_mode"
  ],
  "player_feedback_record_required_fields": [
    "feedback_id",
    "source_id",
    "publication_date",
    "language"
  ],
  "player_feedback_record_allowed_fields": [
    "feedback_id",
    "source_id",
    "url",
    "public_ref",
    "publication_date",
    "language",
    "identity_mode"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema",
      "schema_version",
      "web_evidence_contract_binding",
      "appid",
      "title",
      "generated_at_utc",
      "expires_at_utc",
      "ttl_days",
      "game_identity",
      "summary",
      "observations",
      "conflicts",
      "evidence",
      "provenance"
    ],
    "additionalProperties": true,
    "properties": {
      "schema": {
        "const": "TASTE-STEAM-REVIEW-DOSSIER-V2"
      },
      "schema_version": {
        "type": "integer",
        "const": 2
      },
      "web_evidence_contract_binding": {
        "type": "object"
      },
      "appid": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "generated_at_utc": {
        "type": "string",
        "minLength": 1
      },
      "expires_at_utc": {
        "type": "string",
        "minLength": 1
      },
      "ttl_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      },
      "game_identity": {
        "type": "object",
        "required": [
          "work_title",
          "release_year",
          "resolution_status",
          "identity_source_ids",
          "corroborators"
        ],
        "additionalProperties": true
      },
      "summary": {
        "type": "string",
        "minLength": 20,
        "maxLength": 1200
      },
      "observations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "category",
            "statement",
            "sentiment",
            "recurrence",
            "mention_count",
            "evidence_languages",
            "evidence_status",
            "source_ids",
            "player_feedback_ids"
          ],
          "additionalProperties": true
        }
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "statement",
            "recurrence",
            "mention_count",
            "source_ids",
            "player_feedback_ids"
          ],
          "additionalProperties": true
        }
      },
      "evidence": {
        "type": "object",
        "required": [
          "strategy",
          "research_state",
          "source_mix_status",
          "single_source_reason",
          "russian_attempt",
          "overall_strength",
          "stop_reason",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "adaptive_multi_source_web"
            ]
          },
          "research_state": {
            "type": "string",
            "enum": [
              "sufficient"
            ]
          },
          "source_mix_status": {
            "type": "string",
            "enum": [
              "multi_source",
              "single_source_only"
            ]
          },
          "single_source_reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            ]
          },
          "russian_attempt": {
            "type": "string",
            "enum": [
              "found_and_used",
              "searched_no_existence_signal",
              "existence_established_retrieval_unresolved",
              "existence_established_access_unresolved"
            ]
          },
          "overall_strength": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "limited",
              "conflicted"
            ]
          },
          "stop_reason": {
            "type": "string",
            "enum": [
              "evidence_stable",
              "bounded_limit_reached"
            ]
          },
          "coverage": {
            "type": "object",
            "required": [
              "dimensions",
              "closure_basis",
              "strengths_investigated",
              "weaknesses_tradeoffs_investigated"
            ],
            "additionalProperties": false,
            "properties": {
              "dimensions": {
                "type": "array",
                "minItems": 12,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": [
                    "dimension",
                    "state",
                    "observation_indices"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "enum": [
                        "core_play_mechanics",
                        "controls_game_feel",
                        "progression_development_unlocks",
                        "variety_repetition_over_time",
                        "difficulty_mastery_learning_friction",
                        "pacing_structure_direction",
                        "exploration_mission_activity_structure",
                        "multiplayer_coop_dependence",
                        "story_characters_identity_hooks",
                        "recurring_strengths",
                        "recurring_complaints_tradeoffs",
                        "technical_performance_localization_regional"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "covered",
                        "not_material_or_not_applicable",
                        "exhausted_unavailable",
                        "materially_unresolved"
                      ]
                    },
                    "observation_indices": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "closure_basis": {
                "type": "string",
                "enum": [
                  "broad_neutral_picture",
                  "compact_central_experience",
                  "sufficient_after_route_exhaustion"
                ]
              },
              "strengths_investigated": {
                "type": "boolean"
              },
              "weaknesses_tradeoffs_investigated": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_mix_status": {
                  "const": "multi_source"
                }
              },
              "required": [
                "source_mix_status"
              ]
            },
            "then": {
              "properties": {
                "single_source_reason": {
                  "const": null
                }
              },
              "required": [
                "single_source_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source_mix_status": {
                  "const": "single_source_only"
                }
              },
              "required": [
                "source_mix_status"
              ]
            },
            "then": {
              "properties": {
                "single_source_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "single_source_reason"
              ]
            }
          }
        ]
      },
      "provenance": {
        "type": "object",
        "required": [
          "sources",
          "player_feedback_records"
        ],
        "additionalProperties": false,
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "source_type",
                "domain",
                "publication_date",
                "language",
                "freshness",
                "evidence_role",
                "player_feedback"
              ],
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^source-[0-9]{3}$"
                },
                "source_type": {
                  "type": "string",
                  "enum": [
                    "steam_reviews",
                    "steam_community",
                    "reddit",
                    "forum",
                    "store_user_reviews",
                    "community_discussion",
                    "other_player_feedback",
                    "official_metadata",
                    "professional_context"
                  ]
                },
                "domain": {
                  "type": "string",
                  "minLength": 3
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^/?#\\\\s]+(?:[/?#]|$)"
                },
                "public_ref": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 500
                },
                "publication_date": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "language": {
                  "type": "string",
                  "enum": [
                    "russian",
                    "non_russian",
                    "mixed",
                    "unknown"
                  ]
                },
                "freshness": {
                  "type": "string",
                  "enum": [
                    "recent",
                    "older",
                    "unknown"
                  ]
                },
                "evidence_role": {
                  "type": "string",
                  "enum": [
                    "current_state",
                    "historical",
                    "durable_trait",
                    "uncertain",
                    "identity"
                  ]
                },
                "player_feedback": {
                  "type": "boolean"
                },
                "feedback_surface_mode": {
                  "type": "string",
                  "enum": [
                    "concrete_item_collection"
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "url"
                  ],
                  "not": {
                    "required": [
                      "public_ref"
                    ]
                  }
                },
                {
                  "required": [
                    "public_ref"
                  ],
                  "not": {
                    "required": [
                      "url"
                    ]
                  }
                }
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "url",
                      "player_feedback",
                      "feedback_surface_mode"
                    ],
                    "properties": {
                      "url": {
                        "pattern": "^https://(?:www\\\\.)?store\\\\.steampowered\\\\.com/app/[0-9]+(?:/|[?#]|$)"
                      },
                      "player_feedback": {
                        "const": true
                      },
                      "feedback_surface_mode": {
                        "const": "concrete_item_collection"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source_type": {
                        "enum": [
                          "steam_reviews",
                          "store_user_reviews"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          },
          "player_feedback_records": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  },
  "player_feedback_identity_invariants": {
