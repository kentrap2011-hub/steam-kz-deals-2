{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V2",
  "version": 2,
  "status": "active",
  "schema_revision": "semantic-consistency-gaps-2026-09-17",
  "evidence_contract": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2",
  "evidence_contract_version": 2,
  "dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V2",
  "dossier_schema_version": 2,
  "purpose": "Exact worker-facing neutral multi-source web-evidence dossier shape shared with canonical ingress validation, with content-complete compatibility binding and auditable physical player-feedback identity/count support.",
  "unknown_fields_policy": "top_level_and_observation_extras_remain_permissive_but_raw_body_like_and_personal_or_commercial_fields_are_forbidden;provenance_source_and_player_feedback_record_records_are_strict",
  "compact_provenance_policy_source": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2#compact_provenance",
  "prepublication_validation_policy_source": "TASTE-STEAM-REVIEW-DOSSIER-WEB-EVIDENCE-CONTRACT-V2#prepublication_validation",
  "required_top_level_fields": [
    "schema",
    "schema_version",
    "web_evidence_contract_binding",
    "appid",
    "title",
    "generated_at_utc",
    "expires_at_utc",
    "ttl_days",
    "game_identity",
    "summary",
    "observations",
    "conflicts",
    "evidence",
    "provenance"
  ],
  "enums": {
    "observation_category": [
      "mechanics",
      "structure",
      "pacing",
      "progression",
      "repetition",
      "difficulty",
      "friction",
      "multiplayer",
      "coop",
      "localization",
      "translation",
      "voice",
      "font",
      "encoding",
      "regional",
      "other"
    ],
    "sentiment": ["positive", "negative", "mixed", "neutral"],
    "recurrence": ["strong", "moderate", "limited", "anecdotal"],
    "evidence_languages": ["russian", "non_russian", "mixed", "unknown"],
    "evidence_status": ["current", "historical", "durable", "uncertain"],
    "source_type": [
      "steam_reviews",
      "steam_community",
      "reddit",
      "forum",
      "store_user_reviews",
      "community_discussion",
      "other_player_feedback",
      "official_metadata",
      "professional_context"
    ],
    "source_language": ["russian", "non_russian", "mixed", "unknown"],
    "source_freshness": ["recent", "older", "unknown"],
    "source_evidence_role": ["current_state", "historical", "durable_trait", "uncertain", "identity"],
    "russian_attempt_status": ["found_and_used", "searched_not_found_or_insufficient", "source_access_unavailable"],
    "source_mix_status": ["multi_source", "single_source_only"],
    "research_state": ["sufficient"],
    "research_strategy": ["adaptive_multi_source_web"],
    "research_stop_reason": ["evidence_stable", "bounded_limit_reached"],
    "overall_strength": ["strong", "moderate", "limited", "conflicted"],
    "identity_resolution_status": ["resolved"],
    "identity_corroborator_kind": ["appid", "developer", "publisher", "platform", "version", "other_identifier"]
  },
  "integer_rules": {
    "json_boolean_is_integer": false,
    "schema_version": {"const": 2},
    "ttl_days": {"minimum": 1, "maximum": 60},
    "release_year": {"minimum": 1970, "maximum": 2100},
    "mention_count": {"minimum": 1}
  },
  "timestamp_rules": {
    "type": "string",
    "format": "iso8601_timezone_aware",
    "expires_equals_generated_plus_ttl_days": true,
    "fresh_at_canonical_ingest_required": true,
    "maximum_future_skew_minutes_at_ingest": 5
  },
  "identity_rules": {
    "appid_type": "string",
    "appid_pattern": "^[0-9]+$",
    "buffered_title_must_equal_descriptor_title": true,
    "work_title_must_equal_dossier_title": true,
    "release_year_required": true,
    "identity_source_ids_required": true,
    "appid_corroborator_must_equal_dossier_appid": true,
    "resolved_identity_only": true
  },
  "summary_invariants": {
    "free_form_factual_claims_allowed": false,
    "derived_from_validated_structured_findings": true,
    "canonical_derivation": "Evidence summary: {observation_count} validated structured observations; consult observations and conflicts for supported findings.",
    "observation_count_source": "final_validated_observations_array_length",
    "observation_or_conflict_text_is_not_repeated_in_summary": true
  },
  "observation_invariants": {
    "non_empty": true,
    "exact_duplicate_objects_allowed": false,
    "recurrence_minimum_mentions": {
      "strong": 5,
      "moderate": 3,
      "limited": 2,
      "anecdotal": 1
    },
    "anecdotal_exact_mentions": 1,
    "mention_count_equals_distinct_bound_player_feedback_records": true,
    "bound_player_feedback_record_source_must_be_in_observation_source_ids": true,
    "all_source_ids_must_resolve": true,
    "all_player_feedback_ids_must_resolve": true,
    "current_requires_recent_current_state_source": true,
    "historical_requires_historical_and_recent_current_state_sources": true,
    "durable_requires_durable_trait_source": true
  },
  "conflict_invariants": {
    "required_fields": ["statement", "recurrence", "mention_count", "source_ids", "player_feedback_ids"],
    "exact_duplicate_objects_allowed": false,
    "mention_count_equals_distinct_bound_player_feedback_records": true,
    "recurrence_thresholds_equal_observation_thresholds": true,
    "bound_player_feedback_record_source_must_be_in_conflict_source_ids": true,
    "official_or_professional_context_alone_cannot_establish_recurrence": true
  },
  "overall_strength_invariants": {
    "strong_requires_at_least_one_strong_observation": true,
    "moderate_requires_at_least_one_moderate_or_strong_observation": true,
    "conflict_recurrence_may_promote_overall_strength": false,
    "conflicts_remain_separate_structured_evidence": true
  },
  "provenance_relationship_invariants": {
    "feedback_item_must_match_parent_physical_surface": true,
    "same_thread_distinct_feedback_items_allowed": true,
    "reddit_parent_subreddit_and_thread_scope_must_contain_child_when_resolvable": true,
    "steam_review_and_discussion_surfaces_must_not_be_cross_bound": true,
    "known_older_child_cannot_inherit_recent_parent_freshness": true,
    "unknown_child_publication_date_preserves_existing_undated_behavior": true,
    "parent_child_language_containment": {
      "russian_child_parent_languages": ["russian", "mixed"],
      "non_russian_child_parent_languages": ["non_russian", "mixed"],
      "mixed_or_unknown_child_additional_containment_rule": false
    }
  },
  "evidence_invariants": {
    "strategy": "adaptive_multi_source_web",
    "research_state": "sufficient",
    "at_least_one_bound_player_feedback_record": true,
    "multi_source_requires_at_least_two_distinct_physical_used_player_source_refs": true,
    "single_source_only_requires_reason": true,
    "russian_found_requires_russian_player_feedback_record_used_by_observation_or_conflict": true,
    "russian_used_requires_found_and_used_status": true,
    "professional_context_cannot_be_player_feedback": true,
    "official_metadata_cannot_be_player_feedback": true,
    "steam_store_app_page_cannot_be_player_feedback": true,
    "aggregate_storefront_statistics_cannot_populate_mention_count": true,
    "player_feedback_record_requires_item_level_stable_locator": true,
    "obvious_url_aliases_do_not_create_distinct_feedback_or_source_identity": true,
    "legacy_review_sample_field_forbidden": true,
    "legacy_store_only_or_zero_evidence_placeholder_forbidden": true
  },
  "provenance_source_required_fields": [
    "source_id",
    "source_type",
    "domain",
    "publication_date",
    "language",
    "freshness",
    "evidence_role",
    "player_feedback"
  ],
  "provenance_source_allowed_fields": [
    "source_id",
    "source_type",
    "domain",
    "url",
    "public_ref",
    "publication_date",
    "language",
    "freshness",
    "evidence_role",
    "player_feedback"
  ],
  "player_feedback_record_required_fields": [
    "feedback_id",
    "source_id",
    "publication_date",
    "language"
  ],
  "player_feedback_record_allowed_fields": [
    "feedback_id",
    "source_id",
    "url",
    "public_ref",
    "publication_date",
    "language"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema",
      "schema_version",
      "web_evidence_contract_binding",
      "appid",
      "title",
      "generated_at_utc",
      "expires_at_utc",
      "ttl_days",
      "game_identity",
      "summary",
      "observations",
      "conflicts",
      "evidence",
      "provenance"
    ],
    "additionalProperties": true,
    "properties": {
      "schema": {"const": "TASTE-STEAM-REVIEW-DOSSIER-V2"},
      "schema_version": {"type": "integer", "const": 2},
      "web_evidence_contract_binding": {"type": "object"},
      "appid": {"type": "string", "pattern": "^[0-9]+$"},
      "title": {"type": "string", "minLength": 1, "maxLength": 300},
      "generated_at_utc": {"type": "string", "minLength": 1},
      "expires_at_utc": {"type": "string", "minLength": 1},
      "ttl_days": {"type": "integer", "minimum": 1, "maximum": 60},
      "game_identity": {
        "type": "object",
        "required": ["work_title", "release_year", "resolution_status", "identity_source_ids", "corroborators"],
        "additionalProperties": true
      },
      "summary": {"type": "string", "minLength": 20, "maxLength": 1200},
      "observations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["category", "statement", "sentiment", "recurrence", "mention_count", "evidence_languages", "evidence_status", "source_ids", "player_feedback_ids"],
          "additionalProperties": true
        }
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["statement", "recurrence", "mention_count", "source_ids", "player_feedback_ids"],
          "additionalProperties": true
        }
      },
      "evidence": {
        "type": "object",
        "required": ["strategy", "research_state", "source_mix_status", "single_source_reason", "russian_attempt", "overall_strength", "stop_reason"],
        "additionalProperties": false
      },
      "provenance": {
        "type": "object",
        "required": ["sources", "player_feedback_records"],
        "additionalProperties": false,
        "properties": {
          "sources": {"type": "array", "minItems": 1},
          "player_feedback_records": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
