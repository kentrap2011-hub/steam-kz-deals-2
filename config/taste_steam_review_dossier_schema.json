{
  "schema": "TASTE-STEAM-REVIEW-DOSSIER-WORKER-SCHEMA-V1",
  "version": 1,
  "status": "active",
  "dossier_schema": "TASTE-STEAM-REVIEW-DOSSIER-V1",
  "dossier_schema_version": 1,
  "purpose": "Exact source-independent worker-facing dossier shape shared with canonical ingress validation. Review-source access/sufficiency semantics remain intentionally outside this schema revision.",
  "unknown_fields_policy": "preserve_current_permissive_behavior_except_existing_forbidden_raw_review_and_personal_commercial_keys",
  "source_dependent_fields_intentionally_deferred": [
    "serialized_stop_reason_enum",
    "minimum_usable_review_body_count",
    "review_source_access_unavailable_state",
    "source_specific_review_provenance_identifiers",
    "store_only_zero_review_semantic_completeness"
  ],
  "required_top_level_fields": [
    "schema",
    "schema_version",
    "appid",
    "title",
    "generated_at_utc",
    "expires_at_utc",
    "ttl_days",
    "summary",
    "observations",
    "conflicts",
    "review_sample",
    "provenance"
  ],
  "enums": {
    "observation_category": [
      "mechanics",
      "structure",
      "pacing",
      "progression",
      "repetition",
      "difficulty",
      "friction",
      "multiplayer",
      "coop",
      "localization",
      "translation",
      "voice",
      "font",
      "encoding",
      "regional",
      "other"
    ],
    "sentiment": ["positive", "negative", "mixed", "neutral"],
    "recurrence": ["strong", "moderate", "limited", "anecdotal"],
    "evidence_languages": ["russian", "non_russian", "mixed", "store", "store_and_reviews"],
    "review_lane_language_scope": ["russian", "non_russian"],
    "review_sampling_strategy": ["adaptive_stability"]
  },
  "integer_rules": {
    "json_boolean_is_integer": false,
    "schema_version": {"const": 1},
    "ttl_days": {"minimum": 1, "maximum": 60},
    "mention_count": {"minimum": 1},
    "sample_counts": {"minimum": 0},
    "batch_counts": {"minimum": 0}
  },
  "timestamp_rules": {
    "type": "string",
    "format": "iso8601_timezone_aware",
    "expires_equals_generated_plus_ttl_days": true,
    "maximum_future_skew_minutes_at_ingest": 5
  },
  "identity_rules": {
    "appid_type": "string",
    "appid_pattern": "^[0-9]+$",
    "buffered_title_must_equal_descriptor_title": true,
    "store_and_review_provenance_urls_must_bind_to_appid": true
  },
  "review_sample_invariants": {
    "exact_lane_count": 2,
    "exact_lane_identities": ["russian", "non_russian"],
    "sampled_total_equals_lane_totals": true,
    "lane_sampled_must_equal_top_level_language_count": true,
    "duplicate_lane_identities_allowed": false
  },
  "observation_invariants": {
    "non_empty": true,
    "exact_duplicate_objects_allowed": false,
    "recurrence_minimum_mentions": {
      "strong": 5,
      "moderate": 3,
      "limited": 2,
      "anecdotal": 1
    },
    "anecdotal_exact_mentions": 1
  },
  "provenance_required_structure": {
    "store_description": ["url", "content_sha256"],
    "steam_reviews": ["url"]
  },
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema",
      "schema_version",
      "appid",
      "title",
      "generated_at_utc",
      "expires_at_utc",
      "ttl_days",
      "summary",
      "observations",
      "conflicts",
      "review_sample",
      "provenance"
    ],
    "additionalProperties": true,
    "properties": {
      "schema": {"const": "TASTE-STEAM-REVIEW-DOSSIER-V1"},
      "schema_version": {"type": "integer", "const": 1},
      "appid": {"type": "string", "pattern": "^[0-9]+$"},
      "title": {"type": "string", "minLength": 1, "maxLength": 300},
      "generated_at_utc": {"type": "string", "minLength": 1},
      "expires_at_utc": {"type": "string", "minLength": 1},
      "ttl_days": {"type": "integer", "minimum": 1, "maximum": 60},
      "summary": {"type": "string", "minLength": 20, "maxLength": 1200},
      "observations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["category", "statement", "sentiment", "recurrence", "mention_count", "evidence_languages"],
          "additionalProperties": true,
          "properties": {
            "category": {"enum": ["mechanics", "structure", "pacing", "progression", "repetition", "difficulty", "friction", "multiplayer", "coop", "localization", "translation", "voice", "font", "encoding", "regional", "other"]},
            "statement": {"type": "string", "minLength": 4, "maxLength": 600},
            "sentiment": {"enum": ["positive", "negative", "mixed", "neutral"]},
            "recurrence": {"enum": ["strong", "moderate", "limited", "anecdotal"]},
            "mention_count": {"type": "integer", "minimum": 1},
            "evidence_languages": {
              "type": "array",
              "minItems": 1,
              "items": {"enum": ["russian", "non_russian", "mixed", "store", "store_and_reviews"]}
            }
          }
        }
      },
      "conflicts": {"type": "array"},
      "review_sample": {
        "type": "object",
        "required": ["strategy", "sampled_total", "sampled_russian", "sampled_non_russian", "sample_ids_sha256", "lanes"],
        "additionalProperties": true
      },
      "provenance": {
        "type": "object",
        "required": ["store_description", "steam_reviews"],
        "additionalProperties": true
      }
    }
  }
}
